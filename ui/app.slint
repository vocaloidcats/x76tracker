// x76tracker. Drawn by Slint, styled after the x76.gg design language:
// paper/ink neutrals, Archivo + IBM Plex Mono, pill controls, tier colours. Data comes from Rust.

import { ScrollView, Palette } from "std-widgets.slint";

import "fonts/Archivo-Regular.ttf";
import "fonts/Archivo-Medium.ttf";
import "fonts/Archivo-SemiBold.ttf";
import "fonts/Archivo-Bold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";
import "fonts/IBMPlexMono-Medium.ttf";
import "fonts/IBMPlexMono-SemiBold.ttf";

// ---------------------------------------------------------------- data shapes (filled by Rust)
export struct Tick { y: float, label: string }
export struct ChartPoint { x: float, y: float, value: string, when: string, change: string, dir: int, sub: string }
export struct ChartData { ticks: [Tick], points: [ChartPoint], lookup: [int], start: string, span: string }
// tier-key -1 = not rated (opponent not found on the ladder); gap = their Elo minus yours, dir 1 = they were above you
export struct Opponent { name: string, elo: string, tier-key: int, gap: string, gap-dir: int, won: bool, upset: bool }
// kind: 0 ladder change (W/L from its counts), 1 fight from the game log, 2 x76 booking Elo/points,
// 3 predicted next points booking
export struct EventRow { fresh: bool, kind: int, label: string, id: string, when: string, when-full: string, wins: int, losses: int, note: string, opponents: [Opponent], more: string, elo: string, elo-dir: int, pts: string, pts-dir: int }
export struct PlayerCard {
    game: string, id: string, key: string, name: string, link: bool,
    rank: string, top: int, tier: string, tier-key: int, moved: string, moved-dir: int, missing: bool,
    points: string, points-delta: string, points-dir: int, since: string,
    elo: string, elo-delta: string, elo-dir: int, elo-field: string,
    wins: int, losses: int,
    show-elo: bool, show-all: bool, confirm-remove: bool, flash: int,
    has-chart: bool, chart: ChartData, tracking-since: string,
    events: [EventRow], total-events: int,
    kd: string, kd-ratio: string, acc: string, site24: string, site24-dir: int, site24-places: string, site24-places-dir: int,
    first: bool, last: bool,
    // numbers for the ticking points and Elo: what showed last time, and the new values
    has-num: bool, points-num: float, points-from: float, elo-num: float, elo-from: float,
    // the period's nemesis (beats you most) and favourite victim, with your record against them
    nemesis: string, nemesis-rec: string, victim: string, victim-rec: string,
    // this game's latest session (index), when this is the player picked as yours; -1 if none
    recap: int,
}
export struct SearchResult { id: string, rank: string, name: string, tier: string, tier-key: int, points: string, alias: string, tracked: bool }
export struct GameData { id: string, label: string, mode: string, placeholder: string, players: [PlayerCard] }
// detail panel for one result row
export struct StatChange { label: string, before: string, after: string, change: string, dir: int }
export struct FightDetail {
    when: string, won: bool, opponent: string, tier: string, tier-key: int, rank: string,
    elo: string, points: string, gap: string, gap-dir: int, chance: string, upset: bool,
    now: string, rated: bool, can-track: bool, track-id: string, acc: string,
}
// head-to-head: a tracked player's record against one opponent
export struct RivalTile { label: string, value: string, sub: string, dir: int }
export struct RivalFight { when: string, won: bool, elo: string, gap: string, gap-dir: int, acc: string, upset: bool }
export struct RivalPage {
    open: bool, key: string, game: string, name: string, tier: string, tier-key: int, rank: string,
    headline: string, lead: int, tiles: [RivalTile], fights: [RivalFight], more: string,
    can-track: bool, track-id: string, has-acc: bool, hint: string,
}
// session recap: one stretch of playing, from the game starting to it closing
export struct RecapLine { label: string, name: string, value: string, dir: int }
export struct RecapPage {
    open: bool, index: int, key: string, title: string, subtitle: string, record: string, lead: int,
    tier-from: string, tier-to: string, tier-key: int, tiles: [RivalTile], lines: [RecapLine], note: string,
    has-prev: bool, has-next: bool,
}
export struct EventDetail {
    open: bool, key: string, game: string, title: string, subtitle: string,
    stats: [StatChange], record: string, tier-from: string, tier-to: string, tier-key: int,
    fights: [FightDetail], hint: string,
}
// Servers tab
export struct ServerRow { name: string, region: string, map: string, players: int, max: int, fill: float, online: bool }
export struct ServerGame { label: string, total: int, summary: string, peak: string, peak-at: string, has-chart: bool, chart: ChartData, rows: [ServerRow] }
export struct ServersPage { loaded: bool, ql: ServerGame, r5: ServerGame }
export struct GameRank { label: string, has: bool, name: string, rank: string, tier: string, tier-key: int, points: string, elo: string }
export struct ProfileCard {
    linked: bool, busy: bool, error: string,
    name: string, handle: string, initial: string, badges: [string], supporter: bool, verified: bool,
    has-avatar: bool, has-banner: bool, ql: GameRank, r5: GameRank,
}
// Settings → Discord. Slot kind: 0 stat tile (value + label), 1 text, 2 image, 3 collection card (picture, name, description), 4 progress bar
export struct WidgetSlot { key: string, kind: int, surface: string, name: string, source: int, custom: string, is-custom: bool }
export struct StaticText { surface: string, name: string, text: string }
export struct DiscordPage {
    rpc: bool, rpc-app: string, r5-patch: bool, r5-found: bool, ql-log: bool, recap-auto: bool, notify: bool,
    players-r5: [string], player-r5: int, players-ql: [string], player-ql: int,
    widget: bool, app-id: string, user-id: string, has-token: bool, widget-rpc: bool,
    slots: [WidgetSlot], statics: [StaticText],
    tile-options: [string], text-options: [string], image-options: [string], card-options: [string], progress-options: [string],
}
// Settings → Updates. available = a newer version ("" when up to date); notes = its release notes
// Share card: change = points over 48h without sign (change-dir carries it); record = "321-244 · 48h"
export struct ShareGame { label: string, tier: string, tier-key: int, rank: string, points: string, elo: string, change: string, change-dir: int, record: string, has-chart: bool, chart: ChartData }
export struct ShareCard { ok: bool, name: string, handle: string, initial: string, supporter: bool, has-avatar: bool, has-banner: bool, date: string, games: [ShareGame] }
// What's new. A picture is still (one frame) or animated; aspect = height / width.
// natural = width in points (pixels / density), so a picture is never stretched past its own size
// made-for: the on-screen width (physical pixels) the frames were resampled for, 0 for the picture as it is
export struct ChangeMedia { has: bool, ready: bool, failed: bool, alt: string, src: string, frames: [image], frame-ms: int, aspect: float, natural: float, made-for: int }
export struct ChangeItem { title: string, text: string, media: ChangeMedia }
// kind: 0 new (green), 1 improved (blue), 2 fixed (red), 3 other
export struct ChangeSection { title: string, kind: int, items: [ChangeItem] }
export struct ChangeEntry { version: string, note: string, current: bool, available: bool, hero: ChangeMedia, sections: [ChangeSection] }
export struct UpdatesPage {
    version: string, auto-check: bool, auto-install: bool, dev-build: bool,
    available: string, can-install: bool, busy: bool, page: string,
}

// ---------------------------------------------------------------- actions (handled in Rust)
export global Actions {
    // a What's new picture is drawn this many physical pixels wide and high: resample it to that
    callback media-size(src: string, width: int, height: int);
    callback period(index: int);
    callback interval(index: int);
    callback refresh();
    callback theme(dark: bool);
    callback search(game: string, query: string);
    callback track(game: string, id: string);
    callback remove-ask(key: string);
    callback remove-cancel();
    callback remove(game: string, id: string);
    callback move(game: string, id: string, dir: int);
    callback metric(key: string, elo: bool);
    callback show-all(key: string);
    callback open-profile(id: string);
    callback dismiss-banner();
    callback open-event(key: string, id: string);
    callback close-event();
    callback open-rival(key: string, opponent: string);
    callback close-rival();
    callback open-recap(index: int);
    callback close-recap();
    callback recap-step(dir: int);
    callback recap-auto(on: bool);
    callback notify(on: bool);
    callback notify-test();
    callback mini(on: bool);
    callback profile-link(handle: string);
    callback profile-unlink();
    callback open-x76();
    // settings and Discord
    callback settings-opened();
    callback rpc(on: bool);
    callback player(game: string, index: int);
    callback discord-id(which: string, value: string);
    callback discord-token(token: string);
    callback discord-token-clear();
    callback widget(on: bool);
    callback widget-rpc(on: bool);
    callback widget-layout();
    callback widget-source(key: string, kind: int, index: int);
    callback widget-custom(key: string, text: string);
    callback widget-now();
    callback open-url(url: string);
    callback r5-patch(on: bool);
    callback r5-path(folder: string);
    callback ql-log(on: bool);
    callback update-check();
    callback update-install();
    callback update-setting(which: string, on: bool);
    callback card-opened();
    callback card-save();
    callback card-reveal();
    callback changelog-opened();
    callback changelog-closed();
}

// Implemented in Rust: turns normalised chart points into a step-line path at a given pixel size.
export global ChartMath {
    pure callback step-path(points: [ChartPoint], w: float, h: float, area: bool) -> string;
}

// ---------------------------------------------------------------- tokens
export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> canvas: dark ? #141313 : #f5f3ee;
    out property <color> surface: dark ? #232120 : #fbfaf7;
    out property <color> surface-2: dark ? #3a3735 : #edeae2;
    out property <color> fg: dark ? #f5f3ee : #17161a;
    out property <color> fg-muted: dark ? #a6a29a : #5c5a55;
    out property <color> fg-faint: dark ? #7b776f : #8b887f;
    out property <color> line-1: dark ? #f5f3ee29 : #17161a21;
    out property <color> line-2: dark ? #f5f3ee4d : #17161a3d;
    out property <color> accent-fg: dark ? #8fb4ff : #2b4bf2;
    out property <color> action-bg: dark ? #f5f3ee : #141313;
    out property <color> action-fg: dark ? #17161a : #f5f3ee;
    out property <color> positive: dark ? #57c87f : #2e7d4f;
    out property <color> positive-soft: dark ? #1c3226 : #e1efe6;
    out property <color> danger: dark ? #e0665a : #c03b2d;
    out property <color> danger-soft: dark ? #331f1c : #f7e4e1;
    out property <color> warning: dark ? #e0a54a : #b07c10;
    out property <color> warning-soft: dark ? #33291a : #f6edd8;
    out property <string> mono: "IBM Plex Mono";

    // 0 nab, 1 bronze, 2 silver, 3 gold, 4 platinum, 5 diamond, 6 prism, 7 light
    public pure function tier-color(k: int) -> color {
        return k == 1 ? (dark ? #d98a56 : #a8632f)
            : k == 2 ? (dark ? #b7c3cd : #7c8793)
            : k == 3 ? (dark ? #e8b93a : #b8860b)
            : k == 4 ? (dark ? #57c9b8 : #1f8f7a)
            : k == 5 ? (dark ? #7098ea : #3563c9)
            : k == 6 ? (dark ? #b985f0 : #8b3fd1)
            : k == 7 ? (dark ? #ffd977 : #c07d00)
            : fg-faint;
    }
    public pure function dir-color(d: int) -> color {
        return d > 0 ? positive : d < 0 ? danger : fg-faint;
    }
}

// ---------------------------------------------------------------- small parts
component Mono inherits Text {
    font-family: Theme.mono;
    font-size: 11px;
    color: Theme.fg-muted;
    vertical-alignment: center;
}

component Eyebrow inherits Mono {
    letter-spacing: 0.22px;
}

// x76-style change marker: small ▲/▼ triangle + magnitude, coloured by direction
component Delta inherits HorizontalLayout {
    in property <string> text;
    in property <int> dir;
    in property <length> size: 12px;
    in property <bool> mono: false;
    in property <bool> neutral: false;
    spacing: 3px;
    if root.dir != 0: VerticalLayout {
        alignment: center;
        Path {
            width: root.size * 0.55;
            height: root.size * 0.5;
            viewbox-width: 10;
            viewbox-height: 9;
            commands: root.dir > 0 ? "M 5 0 L 10 9 L 0 9 Z" : "M 0 0 L 10 0 L 5 9 Z";
            fill: root.neutral ? Theme.fg-muted : Theme.dir-color(root.dir);
        }
    }
    Text {
        text: root.text;
        font-family: root.mono ? Theme.mono : "Archivo";
        font-size: root.size;
        font-weight: 500;
        color: root.neutral ? Theme.fg-muted : Theme.dir-color(root.dir);
        vertical-alignment: center;
    }
}

component Pills inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> small;
    callback chosen(index: int);
    background: Theme.surface-2;
    border-radius: self.height / 2;
    HorizontalLayout {
        padding: root.small ? 3px : 4px;
        spacing: root.small ? 2px : 4px;
        for opt[i] in root.options: Rectangle {
            border-radius: self.height / 2;
            background: i == root.selected ? Theme.surface : transparent;
            animate background { duration: 150ms; }
            HorizontalLayout {
                padding-left: root.small ? 11px : 18px;
                padding-right: self.padding-left;
                padding-top: root.small ? 4px : 9px;
                padding-bottom: self.padding-top;
                Text {
                    text: opt;
                    font-size: root.small ? 12px : 13.5px;
                    font-weight: 600;
                    color: i == root.selected || pill-ta.has-hover ? Theme.fg : Theme.fg-muted;
                    horizontal-alignment: center;
                }
            }
            pill-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { if (i != root.selected) { root.chosen(i); } }
            }
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0; // 0 primary, 1 secondary, 2 danger
    in property <bool> enabled: true;
    callback clicked;
    border-radius: self.height / 2;
    background: root.kind == 1 ? (btn-ta.has-hover && root.enabled ? Theme.surface-2 : Theme.surface)
        : root.kind == 2 ? (btn-ta.has-hover ? Theme.danger.darker(0.15) : Theme.danger)
        : (btn-ta.has-hover && root.enabled ? (Theme.dark ? #ffffff : #3a3735) : Theme.action-bg);
    border-width: 1px;
    border-color: root.kind == 1 ? Theme.line-2 : self.background;
    opacity: root.enabled ? (btn-ta.pressed ? 0.72 : 1) : 0.55;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        Text {
            text: root.text;
            font-size: 14px;
            font-weight: 500;
            color: root.kind == 1 ? Theme.fg : root.kind == 2 ? #ffffff : Theme.action-fg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    btn-ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: rb-ta.has-hover && root.enabled ? Theme.canvas : Theme.surface;
    opacity: root.enabled ? (rb-ta.pressed ? 0.6 : 1) : 0.35;
    Path {
        width: 11px;
        height: 11px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.icon;
        stroke: rb-ta.has-hover && root.enabled ? (root.danger ? Theme.danger : Theme.fg) : Theme.fg-muted;
        stroke-width: 1.5px;
    }
    rb-ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// x76's rank emblems by tier-key (0 nab … 7 light), downloaded from x76.gg at runtime
export global RankIcons {
    in property <[image]> icons;
    in property <bool> ready;
}

// Tier marker: x76's emblem when loaded, otherwise a diamond in the tier colour
component Gem inherits Rectangle {
    in property <int> tier-key;
    in property <length> size: 22px;
    property <bool> art: RankIcons.ready && root.tier-key >= 0 && root.tier-key < RankIcons.icons.length;
    width: root.size;
    height: root.size;
    if root.art: Image {
        width: root.size;
        height: root.size;
        source: RankIcons.icons[root.tier-key];
        image-fit: contain;
    }
    if !root.art: Path {
        x: (root.size - self.width) / 2;
        y: (root.size - self.height) / 2;
        width: root.size * 0.55;
        height: root.size * 0.55;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 6 0 L 12 6 L 6 12 L 0 6 Z";
        fill: root.tier-key == 6
            ? @linear-gradient(115deg, #6fe3ff 0%, #9d7bff 35%, #f07ae0 65%, #c6f07a 100%)
            : Theme.tier-color(root.tier-key);
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <int> kind; // 1 win, -1 loss, 0 neutral
    border-radius: 4px;
    background: root.kind > 0 ? Theme.positive-soft : root.kind < 0 ? Theme.danger-soft : Theme.surface-2;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Mono {
            text: root.text;
            height: 19px;
            font-weight: root.kind == 0 ? 500 : 600;
            color: root.kind > 0 ? Theme.positive : root.kind < 0 ? Theme.danger : Theme.fg-muted;
        }
    }
}

// x76's rainbow, with a wave like one running up a beach: while `play` (the pointer is over it),
// tilted colour bands ease forward one rainbow-width over 2 s, each band swelling in turn as the
// crest passes, with a soft bright foam riding it. It ends on exactly the picture it started from,
// and finishes even if the pointer leaves halfway. (Tuned in the Rainbow Wave mockup: tilt 132°, swell 1,
// stagger 0.07, foam 0.4.)
component RainbowFill inherits Rectangle {
    in property <bool> play;
    // t: linear progress, 0 → 1 while hovered, back to 0 once the pointer leaves (timers run
    // reliably in the real window; a hover-started property animation did not)
    property <float> t: 0;
    // a started wave always finishes, even if the pointer leaves; at rest again (t = 1 looks
    // exactly like 0) it resets once the pointer is gone, ready for the next hover
    // a finished wave goes straight back to t = 0 (the exact starting picture) and `done` stops it
    // replaying until the pointer has left
    property <bool> done;
    Timer {
        interval: 16ms;
        running: (root.play && !root.done) || root.t > 0;
        triggered => {
            root.t += 16 / 2000;
            if (root.t >= 1) {
                root.t = 0;
                root.done = true;
            }
        }
    }
    Timer {
        interval: 16ms;
        running: !root.play && root.done;
        triggered => { root.done = false; }
    }
    // eased in and out (cubic)
    property <float> e: root.t < 0.5 ? 4 * root.t * root.t * root.t : 1 - Math.pow(-2 * root.t + 2, 3) / 2;
    // each band swells (up to double width) while the crest passes it, staggered 0.07 apart
    property <float> h0: Math.pow(Math.sin(max(0, min(1, root.t / 0.79)) * 180deg), 2);
    property <float> h1: Math.pow(Math.sin(max(0, min(1, (root.t - 0.07) / 0.79)) * 180deg), 2);
    property <float> h2: Math.pow(Math.sin(max(0, min(1, (root.t - 0.14) / 0.79)) * 180deg), 2);
    property <float> h3: Math.pow(Math.sin(max(0, min(1, (root.t - 0.21) / 0.79)) * 180deg), 2);
    property <float> sum: 4 + root.h0 + root.h1 + root.h2 + root.h3;
    // band widths, normalised so one rainbow always spans exactly 1
    property <float> n0: (1 + root.h0) / root.sum;
    property <float> n1: (1 + root.h1) / root.sum;
    property <float> n2: (1 + root.h2) / root.sum;
    property <float> s0: root.e - 1;
    property <float> s1: root.s0 + root.n0;
    property <float> s2: root.s1 + root.n1;
    property <float> s3: root.s2 + root.n2;
    property <float> s4: root.e;
    property <float> s5: root.s4 + root.n0;
    property <float> s6: root.s5 + root.n1;
    property <float> s7: root.s6 + root.n2;
    property <float> s8: root.e + 1;
    background: @linear-gradient(132deg, #6fe3ff root.s0, #9d7bff root.s1, #f07ae0 root.s2, #c6f07a root.s3,
        #6fe3ff root.s4, #9d7bff root.s5, #f07ae0 root.s6, #c6f07a root.s7, #6fe3ff root.s8);
    // foam: a soft bright band riding the crest, strongest mid-wave
    property <float> foam: 0.4 * Math.sin(root.t * 180deg);
    property <float> c: -0.2 + 1.4 * root.e;
    property <float> c0: root.c - 0.14;
    property <float> c2: root.c + 0.14;
    if root.t > 0 && root.t < 1: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: @linear-gradient(132deg, #ffffff00 root.c0, rgba(255, 255, 255, root.foam) root.c, #ffffff00 root.c2);
    }
}

component SearchBox inherits Rectangle {
    in property <string> placeholder;
    in property <string> game;
    out property <string> query: input.text;
    height: 40px;
    border-radius: 8px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.line-2 : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Path {
                width: 14px;
                height: 14px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 18 11 A 7 7 0 1 1 4 11 A 7 7 0 1 1 18 11 M 20 20 L 16.4 16.4";
                stroke: Theme.fg-faint;
                stroke-width: 1.5px;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                font-size: 13.5px;
                color: Theme.fg;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: Theme.accent-fg.with-alpha(0.35);
                edited => { Actions.search(root.game, self.text); }
            }
            if input.text == "": Text {
                text: root.placeholder;
                font-size: 13.5px;
                color: Theme.fg-faint;
                vertical-alignment: center;
                x: 0;
                width: parent.width;
                height: parent.height;
            }
        }
        if input.text != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            RoundButton {
                width: 22px;
                height: 22px;
                icon: "M 3 3 L 9 9 M 9 3 L 3 9";
                clicked => {
                    input.text = "";
                    Actions.search(root.game, "");
                }
            }
        }
    }
}

// ---------------------------------------------------------------- chart
component Chart inherits Rectangle {
    in property <ChartData> c;
    in property <int> tier-key;
    in property <string> unit;
    property <length> pw: self.width - 50px;
    property <length> ph: self.height - 12px;
    in property <brush> ink: Theme.tier-color(root.tier-key);
    property <int> n: root.c.points.length;
    property <int> hi: ta.has-hover && root.n > 0
        ? root.c.lookup[max(0, min(199, floor(ta.mouse-x / root.pw * 200)))]
        : 0;
    height: 112px;

    for t in root.c.ticks: Rectangle {
        x: 0;
        y: 6px + t.y * root.ph;
        width: root.pw;
        height: 1px;
        background: Theme.line-1;
    }
    for t in root.c.ticks: Mono {
        x: root.pw + 10px;
        y: 6px + t.y * root.ph - 7px;
        height: 14px;
        text: t.label;
        font-size: 10px;
        color: Theme.fg-faint;
    }
    Path {
        x: 0;
        y: 6px;
        width: root.pw;
        height: root.ph;
        viewbox-width: root.pw / 1px;
        viewbox-height: root.ph / 1px;
        commands: ChartMath.step-path(root.c.points, root.pw / 1px, root.ph / 1px, true);
        fill: root.ink;
        opacity: 0.1;
    }
    Path {
        x: 0;
        y: 6px;
        width: root.pw;
        height: root.ph;
        viewbox-width: root.pw / 1px;
        viewbox-height: root.ph / 1px;
        commands: ChartMath.step-path(root.c.points, root.pw / 1px, root.ph / 1px, false);
        stroke: root.ink;
        stroke-width: 1.75px;
    }
    if root.n > 0: Rectangle {
        x: root.pw - 3px;
        y: 6px + root.c.points[root.n - 1].y * root.ph - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.ink;
    }

    ta := TouchArea {
        x: 0;
        width: root.pw;
    }
    if ta.has-hover && root.n > 0: hover := Rectangle {
        property <ChartPoint> p: root.c.points[root.hi];
        property <length> cx: max(0px, min(ta.mouse-x, root.pw));
        Rectangle {
            x: hover.cx;
            y: 6px;
            width: 1px;
            height: root.ph;
            background: Theme.fg-muted.with-alpha(0.6);
        }
        Rectangle {
            x: hover.cx - 4px;
            y: 6px + hover.p.y * root.ph - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.ink;
            border-width: 2px;
            border-color: Theme.surface-2;
        }
        Rectangle {
            x: hover.cx + 14px + self.width > root.pw ? hover.cx - 14px - self.width : hover.cx + 14px;
            y: 2px;
            width: 176px;
            background: Theme.canvas;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line-1;
            VerticalLayout {
                padding: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;
                Eyebrow { text: hover.p.when; font-size: 10px; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 2px;
                    Text { text: hover.p.value; font-size: 18px; font-weight: 600; letter-spacing: -0.36px; color: Theme.fg; }
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 3px;
                        Text { text: root.unit; font-size: 12px; color: Theme.fg-muted; }
                    }
                }
                if hover.p.change != "": HorizontalLayout {
                    alignment: start;
                    spacing: 5px;
                    Delta { text: hover.p.change; dir: hover.p.dir; size: 11px; mono: true; }
                    Mono { text: "vs previous"; }
                }
                Mono { text: hover.p.sub; }
            }
        }
    }
}

// ---------------------------------------------------------------- player card
component PlayerCardView inherits Rectangle {
    in property <PlayerCard> p;
    // points and Elo tick from what was showing to the new value (eased, on a Timer)
    property <float> pts: root.p.points-from;
    property <float> elo-v: root.p.elo-from;
    Timer {
        interval: 16ms;
        running: root.p.has-num && (abs(root.pts - root.p.points-num) > 0.4 || abs(root.elo-v - root.p.elo-num) > 0.04);
        triggered => {
            root.pts += (root.p.points-num - root.pts) * 0.12;
            root.elo-v += (root.p.elo-num - root.elo-v) * 0.12;
            if (abs(root.pts - root.p.points-num) <= 0.4) { root.pts = root.p.points-num; }
            if (abs(root.elo-v - root.p.elo-num) <= 0.04) { root.elo-v = root.p.elo-num; }
        }
    }
    pure function pad3(v: int) -> string { return v < 10 ? "00" + v : v < 100 ? "0" + v : "" + v; }
    // 17433 → "17,433"
    pure function grouped(v: int) -> string {
        return v >= 1000000 ? Math.floor(v / 1000000) + "," + root.pad3(Math.mod(Math.floor(v / 1000), 1000)) + "," + root.pad3(Math.mod(v, 1000))
            : v >= 1000 ? Math.floor(v / 1000) + "," + root.pad3(Math.mod(v, 1000)) : "" + v;
    }
    // 1224.23 → "1,224.2"
    pure function tenths(v: float) -> string {
        return root.grouped(Math.floor(Math.round(v * 10) / 10)) + "." + Math.mod(Math.round(v * 10), 10);
    }
    in property <string> period-word;
    property <string> period-upper: root.period-word == "today" ? "TODAY" : root.period-word == "last 24h" ? "LAST 24H" : "SINCE TRACKING";
    property <bool> faded;
    background: root.p.flash != 0 && !root.faded
        ? Theme.surface-2.mix(root.p.flash > 0 ? Theme.positive-soft : Theme.danger-soft, 0.35)
        : Theme.surface-2;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.p.flash > 0 && !root.faded ? Theme.positive : root.p.flash < 0 && !root.faded ? Theme.danger : transparent;
    animate border-color, background { duration: 900ms; }

    // a fresh result lights the card up briefly, then fades
    Timer {
        interval: 2200ms;
        running: root.p.flash != 0 && !root.faded;
        triggered => { root.faded = true; }
    }

    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 14px;
        spacing: 0;

        // header
        HorizontalLayout {
            spacing: 12px;
            Mono {
                min-width: 34px;
                horizontal-stretch: 0;
                text: root.p.rank;
                font-size: root.p.top > 0 ? 14px : 13px;
                font-weight: root.p.top > 0 ? 600 : 500;
                color: root.p.top == 1 ? Theme.tier-color(3) : root.p.top == 2 ? Theme.tier-color(2) : root.p.top == 3 ? Theme.tier-color(1) : Theme.fg-muted;
            }
            VerticalLayout { alignment: center; horizontal-stretch: 0; Gem { tier-key: root.p.tier-key; size: 30px; } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                name-text := Text {
                    text: root.p.name;
                    font-size: 16px;
                    font-weight: 600;
                    letter-spacing: -0.16px;
                    color: root.p.link && name-ta.has-hover ? Theme.accent-fg : Theme.fg;
                    overflow: elide;
                    name-ta := TouchArea {
                        enabled: root.p.link;
                        mouse-cursor: root.p.link ? pointer : default;
                        clicked => { Actions.open-profile(root.p.id); }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    Mono { text: root.p.tier; font-weight: 600; color: Theme.tier-color(root.p.tier-key); }
                    if root.p.moved-dir != 0: Mono { text: "·"; }
                    if root.p.moved-dir != 0: Delta { text: root.p.moved; dir: root.p.moved-dir; size: 11px; mono: true; }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                HorizontalLayout {
                    spacing: 4px;
                    RoundButton {
                        icon: "M 6 10.5 L 6 1.5 M 2.5 5 L 6 1.5 L 9.5 5";
                        enabled: !root.p.first;
                        clicked => { Actions.move(root.p.game, root.p.id, -1); }
                    }
                    RoundButton {
                        icon: "M 6 1.5 L 6 10.5 M 2.5 7 L 6 10.5 L 9.5 7";
                        enabled: !root.p.last;
                        clicked => { Actions.move(root.p.game, root.p.id, 1); }
                    }
                    RoundButton {
                        icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5";
                        danger: true;
                        clicked => { Actions.remove-ask(root.p.key); }
                    }
                }
            }
        }

        if root.p.confirm-remove: VerticalLayout {
            padding-top: 12px;
            Rectangle {
                background: Theme.danger-soft;
                border-radius: 8px;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    spacing: 8px;
                    Text {
                        text: "Stop tracking " + root.p.name + "? Their history is kept.";
                        font-size: 13px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout { alignment: center; horizontal-stretch: 0; Button { text: "Stop tracking"; kind: 2; clicked => { Actions.remove(root.p.game, root.p.id); } } }
                    VerticalLayout { alignment: center; horizontal-stretch: 0; Button { text: "Cancel"; kind: 1; clicked => { Actions.remove-cancel(); } } }
                }
            }
        }

        if root.p.missing: VerticalLayout {
            padding-top: 12px;
            Rectangle {
                background: Theme.warning-soft;
                border-radius: 8px;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    Text {
                        text: "Not on the current ladder (renamed or dropped off?). Showing the last numbers seen.";
                        font-size: 13px;
                        color: Theme.warning;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // stats
        HorizontalLayout {
            padding-top: 16px;
            spacing: 14px;
            VerticalLayout {
                horizontal-stretch: 1.15;
                Eyebrow { text: "POINTS"; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 1px;
                    Text { text: root.p.has-num ? root.grouped(Math.round(root.pts)) : root.p.points; font-size: 26px; font-weight: 600; letter-spacing: -0.52px; color: Theme.fg; }
                    VerticalLayout { alignment: end; padding-bottom: 5px; Text { text: "P"; font-size: 15px; font-weight: 600; color: Theme.fg-muted; } }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Delta { text: root.p.points-delta; dir: root.p.points-dir; }
                    Mono { text: root.p.since; font-size: 10.5px; color: Theme.fg-faint; }
                }
            }
            Rectangle { width: 1px; background: Theme.line-1; }
            VerticalLayout {
                horizontal-stretch: 1;
                Eyebrow { text: "ELO"; }
                Text { text: root.p.has-num ? root.tenths(root.elo-v) : root.p.elo; font-size: 26px; font-weight: 600; letter-spacing: -0.52px; color: Theme.fg; }
                HorizontalLayout { alignment: start; Delta { text: root.p.elo-delta; dir: root.p.elo-dir; } }
            }
            Rectangle { width: 1px; background: Theme.line-1; }
            VerticalLayout {
                horizontal-stretch: 0.9;
                Eyebrow { text: "W / L"; }
                HorizontalLayout {
                    alignment: start;
                    Text { text: root.p.wins; font-size: 26px; font-weight: 600; letter-spacing: -0.52px; color: Theme.fg; }
                    Text { text: " / "; font-size: 26px; font-weight: 500; color: Theme.fg-faint; }
                    Text { text: root.p.losses; font-size: 26px; font-weight: 600; letter-spacing: -0.52px; color: Theme.fg; }
                }
                Mono { text: root.period-word; font-size: 10.5px; color: Theme.fg-faint; }
            }
        }

        // chart
        HorizontalLayout {
            padding-top: 18px;
            padding-bottom: 8px;
            Eyebrow { text: (root.p.show-elo ? "ELO · " : "POINTS · ") + root.period-upper; horizontal-stretch: 1; }
            Pills {
                options: ["points", "elo"];
                small: true;
                selected: root.p.show-elo ? 1 : 0;
                chosen(i) => { Actions.metric(root.p.key, i == 1); }
            }
        }
        if root.p.has-chart: VerticalLayout {
            Chart {
                c: root.p.chart;
                tier-key: root.p.tier-key;
                unit: root.p.show-elo ? " elo" : "P";
            }
            HorizontalLayout {
                padding-top: 6px;
                Mono { text: root.p.chart.start; font-size: 10px; color: Theme.fg-faint; horizontal-stretch: 1; }
                Mono { text: root.p.chart.span; font-size: 10px; color: Theme.fg-faint; horizontal-alignment: center; horizontal-stretch: 1; }
                Mono { text: "now"; font-size: 10px; color: Theme.fg-faint; horizontal-alignment: right; horizontal-stretch: 1; }
            }
        }
        if !root.p.has-chart: Rectangle {
            height: 112px;
            border-radius: 10px;
            background: Theme.surface;
            Text {
                text: "Tracking since " + root.p.tracking-since + ". The line draws itself as results come in.";
                font-size: 13px;
                color: Theme.fg-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                width: parent.width - 36px;
            }
        }

        // results
        if root.p.events.length > 0: VerticalLayout {
            padding-top: 16px;
            spacing: 3px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Eyebrow { text: "when"; width: 68px; font-size: 10.5px; color: Theme.fg-faint; }
                Eyebrow { text: "result"; horizontal-stretch: 1; font-size: 10.5px; color: Theme.fg-faint; }
                Eyebrow { text: "elo"; width: 76px; horizontal-alignment: right; font-size: 10.5px; color: Theme.fg-faint; }
                Eyebrow { text: "points"; width: 76px; horizontal-alignment: right; font-size: 10.5px; color: Theme.fg-faint; }
            }
            for e in root.p.events: Rectangle {
                // a result that wasn't on the board before fades in and slides down (Timer tween)
                property <float> k: e.fresh ? 0 : 1;
                property <float> ek: 1 - Math.pow(1 - self.k, 3);
                opacity: self.ek;
                Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 420); } }
                height: 33px;
                background: e.kind == 3 ? transparent : row-ta.has-hover && e.id != "" ? Theme.surface.mix(Theme.fg, 0.93) : Theme.surface;
                border-radius: 8px;
                border-width: e.kind == 3 ? 1px : 0px;
                border-color: Theme.line-2;
                // click a result for the full breakdown
                row-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { if (e.id != "") { Actions.open-event(root.p.key, e.id); } }
                }
                HorizontalLayout {
                    y: (1 - parent.ek) * -12px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Mono { text: e.when; width: 68px; font-size: 12px; }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 4px;
                        if e.wins > 0: VerticalLayout { alignment: center; Chip { text: e.wins > 1 ? "\{e.wins}W" : "W"; kind: 1; } }
                        if e.losses > 0: VerticalLayout { alignment: center; Chip { text: e.losses > 1 ? "\{e.losses}L" : "L"; kind: -1; } }
                        if e.note != "": VerticalLayout { alignment: center; Chip { text: e.note; kind: 0; } }
                        if e.label != "": Mono { text: e.label; font-size: 11.5px; color: e.kind == 3 ? Theme.accent-fg : Theme.fg-muted; overflow: elide; min-width: 0px; }
                        for o in e.opponents: HorizontalLayout {
                            spacing: 4px;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            if o.tier-key >= 0: VerticalLayout { alignment: center; Gem { tier-key: o.tier-key; size: 18px; } }
                            Text { text: o.name; font-size: 12.5px; font-weight: 600; color: Theme.fg; overflow: elide; min-width: 0px; vertical-alignment: center; }
                            if o.elo != "": Mono { text: o.elo; font-size: 11.5px; color: Theme.fg-muted; }
                            if o.gap-dir != 0: Delta { text: o.gap; dir: o.gap-dir; size: 10.5px; mono: true; neutral: true; }
                            // an upset you won is a good thing (rainbow); one you lost is not (red)
                            if o.upset: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    border-radius: self.height / 2;
                                    background: o.won ? transparent : Theme.danger;
                                    if o.won: RainbowFill { width: parent.width; height: parent.height; border-radius: parent.height / 2; play: row-ta.has-hover; }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Mono { text: "upset"; font-size: 10px; font-weight: 600; color: o.won ? #17161a : #ffffff; height: 15px; }
                                    }
                                }
                            }
                        }
                        if e.more != "": Mono { text: e.more; font-size: 11.5px; }
                    }
                    Delta { width: 76px; alignment: end; text: e.elo; dir: e.elo-dir; mono: true; }
                    Delta { width: 76px; alignment: end; text: e.pts; dir: e.pts-dir; mono: true; }
                }
            }
            if root.p.total-events > 5: HorizontalLayout {
                alignment: start;
                padding-top: 6px;
                Mono {
                    text: root.p.show-all ? "show less" : "show all \{root.p.total-events} results";
                    color: more-ta.has-hover ? Theme.fg : Theme.accent-fg;
                    more-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.show-all(root.p.key); } }
                }
            }
        }
        if root.p.events.length == 0: VerticalLayout {
            padding-top: 16px;
            Rectangle {
                border-radius: 8px;
                background: Theme.surface;
                HorizontalLayout {
                    padding: 12px;
                    Text {
                        text: root.period-word == "since tracking"
                            ? "No games recorded yet. New results appear here within one check."
                            : "No games recorded " + root.period-word + ". New results appear here within one check.";
                        font-size: 13px;
                        color: Theme.fg-muted;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // footer
        VerticalLayout {
            padding-top: 12px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.line-1; }
            HorizontalLayout {
                alignment: start;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 5px;
                    Mono { text: "k/d"; }
                    Mono { text: root.p.kd; color: Theme.fg; font-weight: 500; }
                    Mono { text: "·"; }
                    Mono { text: root.p.kd-ratio; color: Theme.fg; font-weight: 500; }
                }
                if root.p.acc != "": HorizontalLayout {
                    spacing: 5px;
                    Mono { text: "acc"; }
                    Mono { text: root.p.acc; color: Theme.fg; font-weight: 500; }
                }
                if root.p.site24 != "": HorizontalLayout {
                    spacing: 6px;
                    Mono { text: "x76 24h"; }
                    Delta { text: root.p.site24; dir: root.p.site24-dir; size: 11px; mono: true; }
                    if root.p.site24-places-dir != 0: Delta { text: root.p.site24-places; dir: root.p.site24-places-dir; size: 11px; mono: true; }
                }
            }
            if root.p.nemesis != "" || root.p.victim != "" || root.p.recap >= 0: HorizontalLayout {
                alignment: start;
                spacing: 16px;
                if root.p.recap >= 0: Mono {
                    text: "last session";
                    color: rec-ta.has-hover ? Theme.fg : Theme.accent-fg;
                    rec-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-recap(root.p.recap); } }
                }
                if root.p.nemesis != "": HorizontalLayout {
                    spacing: 5px;
                    Mono { text: "nemesis"; }
                    Mono {
                        text: root.p.nemesis;
                        font-weight: 500;
                        color: nem-ta.has-hover ? Theme.accent-fg : Theme.fg;
                        overflow: elide;
                        max-width: 160px;
                        nem-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-rival(root.p.key, root.p.nemesis); } }
                    }
                    Mono { text: root.p.nemesis-rec; color: Theme.danger; }
                }
                if root.p.victim != "": HorizontalLayout {
                    spacing: 5px;
                    Mono { text: "favourite victim"; }
                    Mono {
                        text: root.p.victim;
                        font-weight: 500;
                        color: vic-ta.has-hover ? Theme.accent-fg : Theme.fg;
                        overflow: elide;
                        max-width: 160px;
                        vic-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-rival(root.p.key, root.p.victim); } }
                    }
                    Mono { text: root.p.victim-rec; color: Theme.positive; }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- game column
component GameColumn inherits Rectangle {
    in property <GameData> g;
    in property <string> status;
    in property <bool> status-error;
    in property <[SearchResult]> results;
    in property <string> search-msg;
    in property <string> period-word;

    VerticalLayout {
        alignment: start;
        spacing: 16px;
        hdr := HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                alignment: end;
                spacing: 6px;
                horizontal-stretch: 1;
                Text { text: root.g.label; font-size: 28px; font-weight: 500; letter-spacing: -0.56px; color: Theme.fg; }
                Mono {
                    text: root.g.mode + " · " + root.status;
                    font-size: 12px;
                    wrap: word-wrap;
                    color: root.status-error ? Theme.danger : Theme.fg-muted;
                }
            }
            VerticalLayout {
                alignment: end;
                horizontal-stretch: 0;
                search := SearchBox {
                    min-width: 180px;
                    preferred-width: 300px;
                    max-width: 320px;
                    game: root.g.id;
                    placeholder: root.g.placeholder;
                }
            }
        }
        if root.g.players.length == 0: Rectangle {
            border-radius: 10px;
            background: Theme.surface-2;
            HorizontalLayout {
                padding: 20px;
                padding-left: 22px;
                Text {
                    text: "No " + root.g.label + " players tracked yet. Find yourself with the search above and hit Track. Every win and loss is recorded from that moment on.";
                    font-size: 14.5px;
                    color: Theme.fg-muted;
                    wrap: word-wrap;
                }
            }
        }
        for p in root.g.players: PlayerCardView {
            p: p;
            period-word: root.period-word;
        }
    }

    // search results drop-down, drawn over the cards
    if search.query != "": Rectangle {
        x: root.width - self.width;
        y: hdr.height + 8px;
        width: min(380px, root.width);
        // sized to its rows, not to the column it floats over
        height: dd.preferred-height;
        background: Theme.canvas;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line-1;
        dd := VerticalLayout {
            padding: 6px;
            for r in root.results: Rectangle {
                border-radius: 6px;
                background: res-ta.has-hover ? Theme.surface-2 : transparent;
                res-ta := TouchArea { }
                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    Mono { text: r.rank; width: 52px; font-size: 12px; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: r.name; font-size: 14.5px; font-weight: 600; letter-spacing: -0.15px; color: Theme.fg; overflow: elide; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            VerticalLayout { alignment: center; Gem { tier-key: r.tier-key; size: 16px; } }
                            Mono { text: r.tier; color: Theme.tier-color(r.tier-key); }
                            Mono { text: "· " + r.points + "P"; }
                            if r.alias != "": Mono { text: "· " + r.alias; overflow: elide; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: r.tracked ? "Tracking" : "Track";
                            kind: r.tracked ? 1 : 0;
                            enabled: !r.tracked;
                            clicked => { Actions.track(root.g.id, r.id); }
                        }
                    }
                }
            }
            if root.search-msg != "": HorizontalLayout {
                padding: 10px;
                Text { text: root.search-msg; font-size: 13.5px; color: Theme.fg-muted; wrap: word-wrap; }
            }
        }
    }
}

// ---------------------------------------------------------------- x76 profile card
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> on-image;
    in property <bool> shiny;
    border-radius: self.height / 2;
    background: root.shiny ? transparent : root.on-image ? #ffffff2e : Theme.surface;
    if root.shiny: RainbowFill { width: parent.width; height: parent.height; border-radius: parent.height / 2; play: pill-ta.has-hover; }
    pill-ta := TouchArea { }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 2px;
        padding-bottom: 2px;
        Mono {
            text: root.text;
            font-size: 10.5px;
            font-weight: root.shiny ? 600 : 500;
            color: root.shiny ? #17161a : root.on-image ? #ffffff : Theme.fg-muted;
        }
    }
}

component RankTile inherits Rectangle {
    in property <GameRank> r;
    in property <bool> on-image;
    property <color> ink: root.on-image ? #ffffff : Theme.fg;
    property <color> soft: root.on-image ? #ffffffb3 : Theme.fg-muted;
    background: root.on-image ? #0000008c : Theme.surface;
    border-radius: 12px;
    min-width: 176px;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        Eyebrow { text: root.r.label; color: root.soft; }
        if root.r.has: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            VerticalLayout { alignment: center; Gem { tier-key: root.r.tier-key; size: 30px; } }
            Text { text: root.r.tier; font-size: 15px; font-weight: 600; color: root.ink; vertical-alignment: center; }
            Mono { text: root.r.rank; font-size: 12px; color: root.soft; }
        }
        if root.r.has: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text { text: root.r.points + "P"; font-size: 13px; font-weight: 600; color: root.ink; }
            Mono { text: root.r.elo + " elo"; font-size: 11.5px; color: root.soft; }
        }
        if !root.r.has: Text {
            text: root.r.name == "" ? "no account linked" : "not on the ladder";
            font-size: 13px;
            color: root.soft;
        }
    }
}

component ProfileCardView inherits Rectangle {
    in property <ProfileCard> p;
    in property <image> avatar;
    in property <image> banner;
    property <bool> img: root.p.has-banner;
    height: 168px;
    border-radius: 16px;
    clip: true;
    background: Theme.surface-2;
    if root.img: Image {
        width: root.width;
        height: root.height;
        source: root.banner;
        image-fit: cover;
    }
    // darken the banner behind the text so it stays readable
    if root.img: Rectangle {
        background: @linear-gradient(90deg, #000000d9 0%, #000000a6 45%, #00000040 100%);
    }
    HorizontalLayout {
        padding: 22px;
        spacing: 18px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 88px;
                height: 88px;
                border-radius: 44px;
                background: root.img ? #ffffff38 : Theme.surface;
                if root.p.has-avatar: Image {
                    x: 4px;
                    y: 4px;
                    width: 80px;
                    height: 80px;
                    source: root.avatar;
                    image-fit: cover;
                }
                if !root.p.has-avatar: Text {
                    text: root.p.initial;
                    font-size: 34px;
                    font-weight: 600;
                    color: root.img ? #ffffff : Theme.fg-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.p.name;
                    font-size: 26px;
                    font-weight: 600;
                    letter-spacing: -0.52px;
                    color: root.img ? #ffffff : Theme.fg;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.p.verified: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Theme.accent-fg;
                        Path {
                            width: 10px;
                            height: 10px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M 2 6.5 L 5 9 L 10 3";
                            stroke: #ffffff;
                            stroke-width: 1.8px;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Mono {
                    text: "@" + root.p.handle;
                    font-size: 12px;
                    color: root.img ? #ffffffb3 : Theme.fg-muted;
                    handle-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-x76(); } }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                padding-top: 2px;
                if root.p.supporter: Pill { text: "supporter"; shiny: true; }
                for b in root.p.badges: Pill { text: b; on-image: root.img; }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 10px;
                RankTile { r: root.p.ql; on-image: root.img; }
                RankTile { r: root.p.r5; on-image: root.img; }
            }
        }
    }
    // share card and unlink, top right
    HorizontalLayout {
        x: root.width - self.preferred-width - 12px;
        y: 12px;
        width: self.preferred-width;
        height: 26px;
        spacing: 8px;
        Rectangle {
            border-radius: self.height / 2;
            background: share-ta.has-hover ? #ffffff40 : #ffffff26;
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                Text { text: "Share card"; font-size: 12px; font-weight: 600; color: root.img ? #ffffff : Theme.fg; vertical-alignment: center; }
            }
            share-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.card-opened(); } }
        }
        RoundButton {
            icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5";
            clicked => { Actions.profile-unlink(); }
        }
    }
}

// ---------------------------------------------------------------- share card (exportable PNG)
// Always drawn dark, whatever the app theme, so a shared card looks the same everywhere.
component ShareGameTile inherits Rectangle {
    in property <ShareGame> g;
    pure function tier-ink(k: int) -> color {
        return k == 1 ? #d98a56 : k == 2 ? #b7c3cd : k == 3 ? #e8b93a : k == 4 ? #57c9b8
            : k == 5 ? #7098ea : k == 6 ? #b985f0 : k == 7 ? #ffd977 : #a6a29a;
    }
    property <color> ink: root.tier-ink(root.g.tier-key);
    background: #ffffff0f;
    border-radius: 14px;
    border-width: 1px;
    border-color: #ffffff1a;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout { alignment: center; horizontal-stretch: 0; Gem { tier-key: root.g.tier-key; size: 44px; } }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.g.label; font-family: Theme.mono; font-size: 9.5px; letter-spacing: 0.5px; color: #ffffff8c; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text { text: root.g.tier; font-size: 16px; font-weight: 600; letter-spacing: -0.2px; color: root.ink; overflow: elide; min-width: 0px; }
                    Text { text: root.g.rank; font-family: Theme.mono; font-size: 11px; color: #ffffffb3; vertical-alignment: center; }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 0;
                Text { text: root.g.points + "P"; font-size: 16px; font-weight: 600; color: #ffffff; horizontal-alignment: right; }
                Text { text: root.g.elo + " elo"; font-family: Theme.mono; font-size: 10.5px; color: #ffffffa6; horizontal-alignment: right; }
            }
        }
        // points over the last 48 hours
        spark := Rectangle {
            height: 30px;
            if root.g.has-chart: Path {
                width: spark.width;
                height: spark.height;
                viewbox-width: spark.width / 1px;
                viewbox-height: spark.height / 1px;
                commands: ChartMath.step-path(root.g.chart.points, spark.width / 1px, spark.height / 1px, true);
                fill: root.ink;
                opacity: 0.14;
            }
            if root.g.has-chart: Path {
                width: spark.width;
                height: spark.height;
                viewbox-width: spark.width / 1px;
                viewbox-height: spark.height / 1px;
                commands: ChartMath.step-path(root.g.chart.points, spark.width / 1px, spark.height / 1px, false);
                stroke: root.ink;
                stroke-width: 1.5px;
            }
            if !root.g.has-chart: Rectangle { y: parent.height - 1px; height: 1px; background: #ffffff1f; }
        }
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            if root.g.change-dir != 0: HorizontalLayout {
                spacing: 3px;
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 6px;
                        height: 5.5px;
                        viewbox-width: 10;
                        viewbox-height: 9;
                        commands: root.g.change-dir > 0 ? "M 5 0 L 10 9 L 0 9 Z" : "M 0 0 L 10 0 L 5 9 Z";
                        fill: root.g.change-dir > 0 ? #57c87f : #e0665a;
                    }
                }
                Text { text: root.g.change; font-family: Theme.mono; font-size: 10.5px; font-weight: 600; color: root.g.change-dir > 0 ? #57c87f : #e0665a; vertical-alignment: center; }
            }
            Text { text: root.g.record; font-family: Theme.mono; font-size: 10.5px; color: #ffffff8c; vertical-alignment: center; }
        }
    }
}

component ShareCardView inherits Rectangle {
    in property <ShareCard> c;
    in property <image> avatar;
    in property <image> banner;
    in property <bool> rounded: true;
    property <length> strip: 118px;
    width: 640px;
    height: 336px;
    border-radius: root.rounded ? 20px : 0px;
    clip: true;
    background: #18171a;
    // banner strip, fading into the card
    Rectangle {
        y: 0;
        height: root.strip;
        clip: true;
        background: @linear-gradient(135deg, #2f2b29 0%, #1d1c1f 100%);
        if root.c.has-banner: Image { width: parent.width; height: parent.height; source: root.banner; image-fit: cover; }
        Rectangle { background: @linear-gradient(180deg, #18171a00 45%, #18171a 100%); }
        // brand, top right
        Rectangle {
            x: parent.width - self.width - 16px;
            y: 14px;
            width: brand.preferred-width;
            height: 26px;
            border-radius: 13px;
            background: #0000008c;
            brand := HorizontalLayout {
                padding-left: 10px;
                padding-right: 11px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 13px;
                        height: 13px;
                        viewbox-width: 32;
                        viewbox-height: 32;
                        commands: "M 6 22 L 12 22 L 12 16 L 18 16 L 18 11 L 26 11";
                        stroke: #ffffff;
                        stroke-width: 2.6px;
                    }
                }
                Text { text: "x76tracker"; font-size: 11.5px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
            }
        }
    }
    // avatar, overlapping the banner
    Rectangle {
        x: 22px;
        y: 66px;
        width: 92px;
        height: 92px;
        border-radius: 46px;
        background: #18171a;
        Rectangle {
            x: 5px;
            y: 5px;
            width: 82px;
            height: 82px;
            border-radius: 41px;
            background: #ffffff26;
            if root.c.has-avatar: Image { width: parent.width; height: parent.height; source: root.avatar; image-fit: cover; }
            if !root.c.has-avatar: Text {
                text: root.c.initial;
                font-size: 32px;
                font-weight: 600;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    // name, handle and date, beside the avatar
    VerticalLayout {
        x: 128px;
        y: root.strip + 4px;
        width: root.width - 128px - 24px;
        height: 54px;
        spacing: 4px;
        alignment: center;
        HorizontalLayout {
            spacing: 10px;
            Text { text: root.c.name; font-size: 24px; font-weight: 600; letter-spacing: -0.48px; color: #ffffff; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
            Text { text: root.c.date; font-family: Theme.mono; font-size: 10.5px; color: #ffffff80; vertical-alignment: center; horizontal-stretch: 0; }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.c.handle != "": Text { text: "@" + root.c.handle; font-family: Theme.mono; font-size: 12px; color: #ffffffb3; vertical-alignment: center; }
            if root.c.supporter: Pill { text: "supporter"; shiny: true; }
        }
    }
    // one tile per game
    HorizontalLayout {
        x: 22px;
        y: 186px;
        width: root.width - 44px;
        height: root.height - 186px - 22px;
        spacing: 12px;
        for g in root.c.games: ShareGameTile { g: g; horizontal-stretch: 1; }
        if root.c.games.length == 0: Text {
            text: "Track yourself on the Ladders tab to put your ranks on this card.";
            font-size: 14px;
            color: #ffffffb3;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

// The card with Save PNG, over the page.
component SharePanel inherits Rectangle {
    in property <ShareCard> c;
    in property <image> avatar;
    in property <image> banner;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> busy;
    in property <bool> saved;
    callback close();
    // opening: fade in and rise (a Timer tween; Slint's `animate` jumps to the end in the real window)
    property <float> k: 0;
    Timer { interval: 16ms; running: root.k < 1; triggered => { root.k = min(1, root.k + 16 / 240); } }
    property <float> ek: 1 - Math.pow(1 - root.k, 3);
    opacity: root.ek;
    background: #000000a6;
    TouchArea { clicked => { root.close(); } }
    panel := Rectangle {
        width: 640px + 48px;
        height: body.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(16px, (root.height - self.height) / 2) + (1 - root.ek) * 22px;
        background: Theme.canvas;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line-2;
        TouchArea { } // clicks inside stay inside
        body := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: "Share card"; font-size: 22px; font-weight: 600; letter-spacing: -0.4px; color: Theme.fg; }
                    Text { text: "Your profile and ranks as a picture, for Discord or anywhere else."; font-size: 13px; color: Theme.fg-muted; }
                }
                VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 0;
                    RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { root.close(); } }
                }
            }
            ShareCardView { c: root.c; avatar: root.avatar; banner: root.banner; }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button { text: root.busy ? "Saving…" : "Save PNG"; enabled: !root.busy && root.c.ok; clicked => { Actions.card-save(); } }
                if root.saved: Button { text: "Show in folder"; kind: 1; clicked => { Actions.card-reveal(); } }
            }
            if root.status != "": Text { text: root.status; font-size: 12.5px; color: root.status-error ? Theme.danger : Theme.fg-muted; wrap: word-wrap; }
        }
    }
}

// "Link your x76 profile" prompt shown until a profile is linked
component LinkProfileRow inherits HorizontalLayout {
    in property <bool> busy;
    in property <string> error;
    property <bool> open;
    alignment: start;
    spacing: 10px;
    if !root.open && !root.busy: Mono {
        text: "x76 member? link your profile to show your card";
        font-size: 12px;
        color: link-ta.has-hover ? Theme.fg : Theme.accent-fg;
        link-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open = true; } }
    }
    if !root.open && !root.busy: Mono {
        text: "· make a share card";
        font-size: 12px;
        color: card-ta.has-hover ? Theme.fg : Theme.fg-muted;
        card-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.card-opened(); } }
    }
    if root.open || root.busy: HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 260px;
            height: 38px;
            border-radius: 8px;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: handle-input.has-focus ? Theme.line-2 : transparent;
            handle-input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                font-size: 13.5px;
                color: Theme.fg;
                single-line: true;
                vertical-alignment: center;
                accepted => { Actions.profile-link(self.text); }
            }
            if handle-input.text == "": Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: "your x76 handle";
                font-size: 13.5px;
                color: Theme.fg-faint;
                vertical-alignment: center;
            }
        }
        VerticalLayout { alignment: center; Button { text: root.busy ? "Linking…" : "Link"; enabled: !root.busy; clicked => { Actions.profile-link(handle-input.text); } } }
        VerticalLayout { alignment: center; Button { text: "Cancel"; kind: 1; clicked => { root.open = false; } } }
    }
    if root.error != "": Text { text: root.error; font-size: 13px; color: Theme.danger; vertical-alignment: center; }
}

// ---------------------------------------------------------------- result detail panel
component StatTile inherits Rectangle {
    in property <StatChange> c;
    background: Theme.surface;
    border-radius: 10px;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Eyebrow { text: root.c.label; font-size: 10.5px; }
        HorizontalLayout { alignment: start; Delta { text: root.c.change; dir: root.c.dir; size: 15px; } }
        Mono { text: root.c.before + "  →  " + root.c.after; font-size: 11px; overflow: elide; }
    }
}

component FightCard inherits Rectangle {
    in property <FightDetail> f;
    in property <string> game;
    // the result's card, for the head-to-head
    in property <string> key;
    background: Theme.surface;
    border-radius: 10px;
    card-ta := TouchArea { }
    HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 0;
            HorizontalLayout { alignment: start; Chip { text: root.f.won ? "WIN" : "LOSS"; kind: root.f.won ? 1 : -1; } }
            Mono { text: root.f.when; font-size: 11px; }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 0; Gem { tier-key: root.f.tier-key; size: 36px; } }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.f.opponent;
                    font-size: 15px;
                    font-weight: 600;
                    color: opp-ta.has-hover ? Theme.accent-fg : Theme.fg;
                    overflow: elide;
                    min-width: 0px;
                    opp-ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-rival(root.key, root.f.opponent); } }
                }
                if root.f.upset: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: self.height / 2;
                        background: root.f.won ? transparent : Theme.danger;
                        if root.f.won: RainbowFill { width: parent.width; height: parent.height; border-radius: parent.height / 2; play: card-ta.has-hover; }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Mono { text: "upset"; font-size: 10.5px; font-weight: 600; color: root.f.won ? #17161a : #ffffff; height: 17px; }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.f.tier != "": Mono { text: root.f.tier; font-weight: 600; color: Theme.tier-color(root.f.tier-key); }
                if root.f.rank != "": Mono { text: root.f.rank; }
                if root.f.points != "": Mono { text: root.f.points; }
            }
            if root.f.acc != "": Mono { text: root.f.acc; font-size: 10.5px; color: Theme.fg-muted; overflow: elide; }
            if root.f.now != "": Mono { text: root.f.now; font-size: 10.5px; color: Theme.fg-faint; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 0;
            if root.f.rated: HorizontalLayout {
                alignment: end;
                spacing: 4px;
                Text { text: root.f.elo; font-size: 17px; font-weight: 600; letter-spacing: -0.3px; color: Theme.fg; }
                VerticalLayout { alignment: end; padding-bottom: 2px; Mono { text: "elo"; } }
            }
            if root.f.rated: HorizontalLayout {
                alignment: end;
                spacing: 5px;
                if root.f.gap-dir != 0: Delta { text: root.f.gap; dir: root.f.gap-dir; size: 11px; mono: true; neutral: true; }
                Mono { text: root.f.gap-dir > 0 ? "above you" : root.f.gap-dir < 0 ? "below you" : "same as you"; }
            }
            if root.f.chance != "": Mono { text: root.f.chance; horizontal-alignment: right; }
            if !root.f.rated: Mono { text: "not rated"; horizontal-alignment: right; }
        }
        if root.f.can-track: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button { text: "Track"; kind: 1; clicked => { Actions.track(root.game, root.f.track-id); } }
        }
    }
}

component EventPanel inherits Rectangle {
    in property <EventDetail> d;
    // opening: fade in and rise (a Timer tween; Slint's `animate` jumps to the end in the real window)
    property <float> k: 0;
    Timer { interval: 16ms; running: root.k < 1; triggered => { root.k = min(1, root.k + 16 / 240); } }
    property <float> ek: 1 - Math.pow(1 - root.k, 3);
    opacity: root.ek;
    background: #000000a6;
    // a click outside the panel closes it
    TouchArea { clicked => { Actions.close-event(); } }
    panel := Rectangle {
        width: min(700px, root.width - 48px);
        height: min(root.height - 64px, body.preferred-height + 2px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - root.ek) * 22px;
        background: Theme.canvas;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line-2;
        clip: true;
        TouchArea { } // clicks inside stay inside
        inner := ScrollView {
            content-width: self.visible-width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: inner.visible-width;
                padding: 22px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Eyebrow { text: "RESULT"; }
                        Text { text: root.d.title; font-size: 22px; font-weight: 600; letter-spacing: -0.4px; color: Theme.fg; }
                        Mono { text: root.d.subtitle; font-size: 11.5px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { Actions.close-event(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        border-radius: self.height / 2;
                        background: Theme.surface-2;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: root.d.record; font-size: 13px; font-weight: 600; color: Theme.fg; }
                        }
                    }
                    if root.d.tier-from != root.d.tier-to && root.d.tier-to != "": Rectangle {
                        border-radius: self.height / 2;
                        background: Theme.surface-2;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout { alignment: center; Gem { tier-key: root.d.tier-key; size: 20px; } }
                            Text { text: root.d.tier-from + "  →  " + root.d.tier-to; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    for c in root.d.stats: StatTile { c: c; horizontal-stretch: 1; }
                }
                if root.d.fights.length > 0: Eyebrow { text: "FIGHTS FROM THE GAME LOG"; }
                for f in root.d.fights: FightCard { f: f; game: root.d.game; key: root.d.key; }
                Text { text: root.d.hint; font-size: 12px; color: Theme.fg-faint; wrap: word-wrap; }
            }
        }
    }
}

// ---------------------------------------------------------------- head-to-head
component RivalTileView inherits Rectangle {
    in property <RivalTile> t;
    // the same width for every tile in a row, however long its text
    preferred-width: 100px;
    background: Theme.surface;
    border-radius: 10px;
    VerticalLayout {
        // a tile with less text keeps its lines at the top, level with its neighbours
        alignment: start;
        padding: 12px;
        spacing: 4px;
        Eyebrow { text: root.t.label; font-size: 10.5px; }
        Text {
            text: root.t.value;
            font-size: 17px;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: root.t.dir > 0 ? Theme.positive : root.t.dir < 0 ? Theme.danger : Theme.fg;
            overflow: elide;
        }
        Mono { text: root.t.sub; font-size: 11px; wrap: word-wrap; }
    }
}

component RivalFightRow inherits Rectangle {
    in property <RivalFight> f;
    in property <bool> has-acc;
    height: 40px;
    background: Theme.surface;
    border-radius: 8px;
    row-ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;
        // the same width for WIN and LOSS, so the times line up
        VerticalLayout { alignment: center; horizontal-stretch: 0; min-width: 46px; HorizontalLayout { alignment: start; Chip { text: root.f.won ? "WIN" : "LOSS"; kind: root.f.won ? 1 : -1; } } }
        Mono { text: root.f.when; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.f.upset: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                border-radius: self.height / 2;
                background: root.f.won ? transparent : Theme.danger;
                if root.f.won: RainbowFill { width: parent.width; height: parent.height; border-radius: parent.height / 2; play: row-ta.has-hover; }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Mono { text: "upset"; font-size: 10.5px; font-weight: 600; color: root.f.won ? #17161a : #ffffff; height: 17px; }
                }
            }
        }
        if root.has-acc: Mono { text: root.f.acc; vertical-alignment: center; horizontal-stretch: 0; min-width: 76px; horizontal-alignment: right; }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            horizontal-stretch: 0;
            min-width: 120px;
            Mono { text: root.f.elo; color: Theme.fg; vertical-alignment: center; }
            if root.f.gap-dir != 0: VerticalLayout { alignment: center; Delta { text: root.f.gap; dir: root.f.gap-dir; size: 11px; mono: true; neutral: true; } }
        }
    }
}

component RecapPanel inherits Rectangle {
    in property <RecapPage> r;
    property <float> k: 0;
    Timer { interval: 16ms; running: root.k < 1; triggered => { root.k = min(1, root.k + 16 / 240); } }
    property <float> ek: 1 - Math.pow(1 - root.k, 3);
    opacity: root.ek;
    background: #000000a6;
    TouchArea { clicked => { Actions.close-recap(); } }
    panel := Rectangle {
        width: min(640px, root.width - 48px);
        height: min(root.height - 64px, body.preferred-height + 2px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - root.ek) * 22px;
        background: Theme.canvas;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line-2;
        clip: true;
        TouchArea { }
        inner := ScrollView {
            content-width: self.visible-width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: inner.visible-width;
                padding: 22px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Eyebrow { text: "SESSION RECAP"; }
                        Text { text: root.r.title; font-size: 22px; font-weight: 600; letter-spacing: -0.4px; color: Theme.fg; }
                        Mono { text: root.r.subtitle; font-size: 11.5px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { Actions.close-recap(); } }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Rectangle {
                        border-radius: self.height / 2;
                        background: root.r.lead > 0 ? Theme.positive.with-alpha(0.16) : root.r.lead < 0 ? Theme.danger.with-alpha(0.16) : Theme.surface-2;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text { text: root.r.record; font-size: 14px; font-weight: 600; color: root.r.lead > 0 ? Theme.positive : root.r.lead < 0 ? Theme.danger : Theme.fg; }
                        }
                    }
                    if root.r.tier-from != root.r.tier-to && root.r.tier-to != "" && root.r.tier-from != "": Rectangle {
                        border-radius: self.height / 2;
                        background: Theme.surface-2;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 12px;
                            spacing: 6px;
                            VerticalLayout { alignment: center; Gem { tier-key: root.r.tier-key; size: 20px; } }
                            Text { text: root.r.tier-from + "  →  " + root.r.tier-to; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
                        }
                    }
                }
                if root.r.tiles.length > 0: HorizontalLayout {
                    spacing: 8px;
                    for t in root.r.tiles: RivalTileView { t: t; horizontal-stretch: 1; }
                }
                if root.r.lines.length > 0: VerticalLayout {
                    spacing: 6px;
                    for l in root.r.lines: Rectangle {
                        height: 40px;
                        background: Theme.surface;
                        border-radius: 8px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            Mono { text: l.label; vertical-alignment: center; min-width: 120px; horizontal-stretch: 0; }
                            Text {
                                text: l.name;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                                color: name-ta.has-hover && l.name != "" ? Theme.accent-fg : Theme.fg;
                                name-ta := TouchArea {
                                    mouse-cursor: l.name != "" ? pointer : default;
                                    clicked => { if (l.name != "") { Actions.open-rival(root.r.key, l.name); } }
                                }
                            }
                            Mono {
                                text: l.value;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                                color: l.dir > 0 ? Theme.positive : l.dir < 0 ? Theme.danger : Theme.fg;
                            }
                        }
                    }
                }
                Text { text: root.r.note; font-size: 12px; color: Theme.fg-faint; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: space-between;
                    if root.r.has-prev: Button { text: "Older session"; kind: 1; clicked => { Actions.recap-step(-1); } }
                    if !root.r.has-prev: Rectangle { }
                    if root.r.has-next: Button { text: "Newer session"; kind: 1; clicked => { Actions.recap-step(1); } }
                }
            }
        }
    }
}

component RivalPanel inherits Rectangle {
    in property <RivalPage> r;
    // opening: fade in and rise (a Timer tween; Slint's `animate` jumps to the end in the real window)
    property <float> k: 0;
    Timer { interval: 16ms; running: root.k < 1; triggered => { root.k = min(1, root.k + 16 / 240); } }
    property <float> ek: 1 - Math.pow(1 - root.k, 3);
    opacity: root.ek;
    background: #000000a6;
    TouchArea { clicked => { Actions.close-rival(); } }
    panel := Rectangle {
        width: min(640px, root.width - 48px);
        height: min(root.height - 64px, body.preferred-height + 2px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - root.ek) * 22px;
        background: Theme.canvas;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line-2;
        clip: true;
        TouchArea { }
        inner := ScrollView {
            content-width: self.visible-width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: inner.visible-width;
                padding: 22px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { alignment: center; horizontal-stretch: 0; Gem { tier-key: root.r.tier-key; size: 44px; } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Eyebrow { text: "HEAD TO HEAD"; }
                        Text { text: root.r.name; font-size: 22px; font-weight: 600; letter-spacing: -0.4px; color: Theme.fg; overflow: elide; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            if root.r.tier != "": Mono { text: root.r.tier; font-weight: 600; color: Theme.tier-color(root.r.tier-key); }
                            if root.r.rank != "": Mono { text: root.r.rank; }
                        }
                    }
                    if root.r.can-track: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button { text: "Track"; kind: 1; clicked => { Actions.track(root.r.game, root.r.track-id); } }
                    }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { Actions.close-rival(); } }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        border-radius: self.height / 2;
                        background: root.r.lead > 0 ? Theme.positive.with-alpha(0.16) : root.r.lead < 0 ? Theme.danger.with-alpha(0.16) : Theme.surface-2;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: root.r.headline;
                                font-size: 14px;
                                font-weight: 600;
                                color: root.r.lead > 0 ? Theme.positive : root.r.lead < 0 ? Theme.danger : Theme.fg;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    for t in root.r.tiles: RivalTileView { t: t; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 12px;
                    Eyebrow { text: "FIGHTS"; horizontal-stretch: 1; }
                    if root.r.has-acc: Eyebrow { text: "YOU · THEM"; horizontal-stretch: 0; min-width: 76px; horizontal-alignment: right; }
                    Eyebrow { text: "THEIR ELO THEN"; horizontal-stretch: 0; min-width: 120px; horizontal-alignment: right; }
                }
                VerticalLayout {
                    spacing: 6px;
                    for f in root.r.fights: RivalFightRow { f: f; has-acc: root.r.has-acc; }
                }
                if root.r.more != "": Mono { text: root.r.more; }
                Text { text: root.r.hint; font-size: 12px; color: Theme.fg-faint; wrap: word-wrap; }
            }
        }
    }
}

// ---------------------------------------------------------------- servers tab
component ServerRowView inherits Rectangle {
    in property <ServerRow> r;
    property <bool> full: root.r.online && root.r.max > 0 && root.r.players >= root.r.max;
    height: 58px;
    background: Theme.surface-2;
    border-radius: 12px;
    opacity: root.r.online ? 1 : 0.55;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: !root.r.online ? Theme.fg-faint : root.r.players > 0 ? Theme.positive : Theme.fg-muted;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.r.name; font-size: 14.5px; font-weight: 600; letter-spacing: -0.15px; color: Theme.fg; overflow: elide; min-width: 0px; }
            Mono { text: root.r.online ? (root.r.region + " · " + root.r.map) : (root.r.region + " · offline"); overflow: elide; min-width: 0px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 0;
            HorizontalLayout {
                alignment: end;
                spacing: 2px;
                Text { text: root.r.players; font-size: 17px; font-weight: 600; color: Theme.fg; }
                VerticalLayout { alignment: end; padding-bottom: 2px; Mono { text: "/\{root.r.max}"; } }
            }
            Rectangle {
                width: 120px;
                height: 5px;
                border-radius: 2.5px;
                background: Theme.surface;
                Rectangle {
                    x: 0;
                    width: parent.width * root.r.fill;
                    height: parent.height;
                    border-radius: 2.5px;
                    background: root.full ? Theme.warning : Theme.accent-fg;
                    animate width { duration: 600ms; easing: ease-out; }
                }
            }
        }
    }
}

component ServerColumn inherits VerticalLayout {
    in property <ServerGame> g;
    // the player count eases to its new value (Timer tween)
    property <float> shown-total: root.g.total;
    Timer {
        interval: 16ms;
        running: abs(root.shown-total - root.g.total) > 0.4;
        triggered => {
            root.shown-total += (root.g.total - root.shown-total) * 0.15;
            if (abs(root.shown-total - root.g.total) <= 0.4) { root.shown-total = root.g.total; }
        }
    }
    alignment: start;
    spacing: 14px;
    VerticalLayout {
        spacing: 6px;
        Text { text: root.g.label; font-size: 28px; font-weight: 500; letter-spacing: -0.56px; color: Theme.fg; }
        Mono { text: root.g.summary; font-size: 12px; wrap: word-wrap; }
    }
    Rectangle {
        background: Theme.surface-2;
        border-radius: 16px;
        VerticalLayout {
            padding: 18px;
            padding-bottom: 14px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 0;
                    Eyebrow { text: "PLAYING NOW"; }
                    Text { text: Math.round(root.shown-total); font-size: 44px; font-weight: 600; letter-spacing: -0.9px; color: Theme.fg; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 0;
                    Eyebrow { text: "PEAK TODAY"; horizontal-alignment: right; }
                    Text { text: root.g.peak; font-size: 20px; font-weight: 600; color: Theme.fg; horizontal-alignment: right; }
                    Mono { text: root.g.peak-at; font-size: 10.5px; color: Theme.fg-faint; horizontal-alignment: right; }
                }
            }
            if root.g.has-chart: VerticalLayout {
                Chart { c: root.g.chart; ink: Theme.accent-fg; unit: " players"; }
                HorizontalLayout {
                    padding-top: 6px;
                    Mono { text: root.g.chart.start; font-size: 10px; color: Theme.fg-faint; horizontal-stretch: 1; }
                    Mono { text: root.g.chart.span; font-size: 10px; color: Theme.fg-faint; horizontal-alignment: center; horizontal-stretch: 1; }
                    Mono { text: "now"; font-size: 10px; color: Theme.fg-faint; horizontal-alignment: right; horizontal-stretch: 1; }
                }
            }
            if !root.g.has-chart: Rectangle {
                height: 112px;
                border-radius: 10px;
                background: Theme.surface;
                Text {
                    width: parent.width - 36px;
                    text: "The chart fills in as the app checks x76's servers (every minute while it's open).";
                    font-size: 13px;
                    color: Theme.fg-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
    for r in root.g.rows: ServerRowView { r: r; }
}

// ---------------------------------------------------------------- settings
component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(on: bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.positive : Theme.surface-2;
    border-width: 1px;
    border-color: root.on ? Theme.positive : Theme.line-2;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 150ms; }
    Rectangle {
        y: 3px;
        x: root.on ? root.width - 19px : 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? #ffffff : Theme.fg-muted;
        animate x { duration: 150ms; }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.toggled(!root.on); } }
    }
}

// A dropdown: shows the chosen option, opens a scrollable list on click.
component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback chosen(index: int);
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: pick-ta.has-hover ? Theme.line-2 : Theme.line-1;
    background: Theme.canvas;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "–";
            font-size: 13px;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Path {
                width: 9px;
                height: 5px;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M 1 1 L 5 5 L 9 1";
                stroke: Theme.fg;
                stroke-width: 1.4px;
            }
        }
    }
    pick-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 240px);
        height: min(root.options.length * 32px + 14px, 340px);
        Rectangle {
            // drops in: fade and slide (Timer tween)
            property <float> k: 0;
            property <float> ek: 1 - Math.pow(1 - self.k, 3);
            opacity: self.ek;
            y: (self.ek - 1) * 8px;
            Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 170); } }
            background: Theme.canvas;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line-2;
            clip: true;
            list := ScrollView {
                content-width: self.visible-width;
                content-height: items.preferred-height;
                items := VerticalLayout {
                    width: list.visible-width;
                    padding: 6px;
                    for opt[i] in root.options: Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: item-ta.has-hover ? Theme.surface-2 : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: opt;
                                font-size: 13px;
                                font-weight: i == root.selected ? 600 : 400;
                                color: Theme.fg;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        item-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.chosen(i); }
                        }
                    }
                }
            }
        }
    }
}

// Single-line text box. `initial` fills it once; after that it's the user's text.
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <string> initial;
    in property <bool> password;
    in property <bool> mono;
    out property <string> value: input.text;
    callback edited(text: string);
    callback accepted(text: string);
    height: 36px;
    border-radius: 8px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.line-2 : transparent;
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.initial;
        font-size: root.mono ? 12.5px : 13.5px;
        font-family: root.mono ? Theme.mono : "Archivo";
        color: Theme.fg;
        single-line: true;
        vertical-alignment: center;
        input-type: root.password ? InputType.password : InputType.text;
        selection-background-color: Theme.accent-fg.with-alpha(0.35);
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
    if input.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-size: 13px;
        color: Theme.fg-faint;
        vertical-alignment: center;
        overflow: elide;
    }
}

// state: 0 off, 1 on and waiting, 2 working, 3 needs attention
component StatusLine inherits HorizontalLayout {
    in property <string> text;
    in property <int> state;
    spacing: 8px;
    VerticalLayout {
        alignment: start;
        padding-top: 6px;
        horizontal-stretch: 0;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: root.state == 2 ? Theme.positive : root.state == 1 ? Theme.accent-fg : root.state == 3 ? Theme.danger : Theme.fg-faint;
        }
    }
    Text {
        text: root.text;
        font-size: 13px;
        color: root.state == 3 ? Theme.danger : Theme.fg-muted;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

component SettingRow inherits HorizontalLayout {
    in property <bool> on;
    in property <string> title;
    in property <string> body;
    callback toggled(on: bool);
    spacing: 14px;
    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        horizontal-stretch: 0;
        Switch { on: root.on; toggled(v) => { root.toggled(v); } }
    }
    VerticalLayout {
        spacing: 3px;
        horizontal-stretch: 1;
        Text { text: root.title; font-size: 15px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
        if root.body != "": Text { text: root.body; font-size: 13px; color: Theme.fg-muted; wrap: word-wrap; }
    }
}

// One User Data field of the widget and what fills it.
component SlotRow inherits Rectangle {
    in property <WidgetSlot> slot;
    in property <[string]> options;
    in property <string> preview;
    background: Theme.surface;
    border-radius: 10px;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                width: 140px;
                Text { text: root.slot.name; font-size: 14px; font-weight: 600; color: Theme.fg; overflow: elide; }
                Mono { text: root.slot.surface; font-size: 10.5px; }
            }
            Select {
                horizontal-stretch: 1;
                options: root.options;
                selected: root.slot.source;
                chosen(i) => { Actions.widget-source(root.slot.key, root.slot.kind, i); }
            }
        }
        if root.slot.is-custom: Field {
            initial: root.slot.custom;
            placeholder: "your text";
            edited(t) => { Actions.widget-custom(root.slot.key, t); }
        }
        if !root.slot.is-custom && root.preview != "": Mono { text: root.preview; font-size: 11.5px; wrap: word-wrap; }
    }
}

// ---------------------------------------------------------------- What's new (Discord-style changelog)
// A changelog picture: still, or animated (frames switch on Slint's animation clock).
component MediaView inherits Rectangle {
    in property <ChangeMedia> m;
    property <length> w: root.m.ready && root.m.natural > 0 ? min(root.width, root.m.natural * 1px + 2px) : root.width;
    height: root.m.ready ? (root.w - 2px) * root.m.aspect + 2px : 96px;
    // The software renderer scales an image by taking the nearest pixel, so a 2x picture shown at
    // half size would keep one pixel in four and its text would look jagged. Instead x76tracker
    // resamples each picture (properly filtered) to the exact physical size it's drawn at; until
    // that's ready, and while the window is being resized, the picture as it is stands in.
    property <int> want-w: root.m.ready ? round((root.w - 2px) / 1phx) : 0;
    property <int> want-h: root.m.ready ? round((root.height - 2px) / 1phx) : 0;
    Timer {
        interval: 250ms;
        running: root.want-w > 0 && root.want-w != root.m.made-for;
        triggered => { Actions.media-size(root.m.src, root.want-w, root.want-h); }
    }
    Rectangle {
        x: 0;
        width: root.w;
        height: root.height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line-1;
        if root.m.ready: Image {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            // fill: a resampled picture is exactly this size (contain could shrink it by a pixel)
            image-fit: fill;
            source: root.m.frames.length > 1
                ? root.m.frames[Math.mod(Math.floor(animation-tick() / 1ms / max(10, root.m.frame-ms)), root.m.frames.length)]
                : root.m.frames[0];
        }
        if !root.m.ready: Mono {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            text: root.m.failed ? "(" + root.m.alt + ")" : "loading picture…";
            color: Theme.fg-faint;
        }
    }
}

component ChangelogMenu inherits Rectangle {
    in property <[ChangeEntry]> entries;
    in-out property <int> selected;
    in property <bool> can-install;
    in property <bool> busy;
    callback close();
    property <ChangeEntry> e: root.entries[root.selected];
    pure function ink(kind: int) -> color {
        return kind == 0 ? Theme.positive : kind == 1 ? Theme.accent-fg : kind == 2 ? Theme.danger : Theme.fg-muted;
    }
    // opening: fade in and rise (a Timer tween; Slint's `animate` jumps to the end in the real window)
    property <float> k: 0;
    Timer { interval: 16ms; running: root.k < 1; triggered => { root.k = min(1, root.k + 16 / 240); } }
    property <float> ek: 1 - Math.pow(1 - root.k, 3);
    opacity: root.ek;
    background: #000000b3;
    TouchArea { clicked => { root.close(); } }
    panel := Rectangle {
        width: min(780px, root.width - 48px);
        height: root.height - 40px;
        x: (root.width - self.width) / 2;
        y: 20px + (1 - root.ek) * 30px;
        background: Theme.canvas;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line-2;
        clip: true;
        TouchArea { } // clicks inside stay inside
        VerticalLayout {
            // header: title, versions, close
            VerticalLayout {
                padding: 22px;
                padding-bottom: 14px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text { text: "What's new"; font-size: 24px; font-weight: 600; letter-spacing: -0.48px; color: Theme.fg; }
                        Text { text: "x76tracker's changelog. Pick a version to see what it changed."; font-size: 13px; color: Theme.fg-muted; }
                    }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { root.close(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for v[i] in root.entries: Rectangle {
                        height: 30px;
                        border-radius: 15px;
                        background: i == root.selected ? Theme.action-bg : chip-ta.has-hover ? Theme.surface-2 : Theme.surface;
                        animate background { duration: 140ms; }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            if v.available: VerticalLayout {
                                alignment: center;
                                Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Theme.accent-fg; }
                            }
                            Text {
                                text: v.version;
                                font-size: 13px;
                                font-weight: 600;
                                color: i == root.selected ? Theme.action-fg : Theme.fg;
                                vertical-alignment: center;
                            }
                        }
                        chip-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected = i;
                                sv.content-y = 0;
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line-1; }
            sv := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: sv.visible-width;
                    padding: 24px;
                    padding-top: 20px;
                    spacing: 18px;
                    if root.e.available: Rectangle {
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.accent-fg;
                        HorizontalLayout {
                            padding: 14px;
                            padding-left: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: "x76tracker " + root.e.version + " is out"; font-size: 15px; font-weight: 600; color: Theme.fg; }
                                Text { text: "It replaces this version when you install it. You can also let it install itself when you close x76tracker (Settings → Updates)."; font-size: 12.5px; color: Theme.fg-muted; wrap: word-wrap; }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Button { text: "Install and restart"; enabled: root.can-install && !root.busy; clicked => { Actions.update-install(); } }
                            }
                        }
                    }
                    if root.e.hero.has: MediaView { m: root.e.hero; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text { text: root.e.version; font-size: 28px; font-weight: 600; letter-spacing: -0.56px; color: Theme.fg; vertical-alignment: center; }
                        if root.e.current || root.e.available: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                border-radius: self.height / 2;
                                background: root.e.available ? Theme.accent-fg : Theme.surface-2;
                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    Mono {
                                        text: root.e.available ? "new" : "this version";
                                        font-size: 11px;
                                        height: 20px;
                                        font-weight: 600;
                                        color: root.e.available ? (Theme.dark ? #17161a : #ffffff) : Theme.fg-muted;
                                    }
                                }
                            }
                        }
                    }
                    if root.e.note != "": Text { text: root.e.note; font-size: 13.5px; color: Theme.fg-muted; wrap: word-wrap; }
                    for sec in root.e.sections: VerticalLayout {
                        spacing: 14px;
                        if sec.title != "": HorizontalLayout {
                            spacing: 10px;
                            Text { text: sec.title; font-family: Theme.mono; font-size: 11.5px; font-weight: 600; letter-spacing: 0.6px; color: root.ink(sec.kind); horizontal-stretch: 0; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Rectangle { height: 1px; background: root.ink(sec.kind).with-alpha(0.35); }
                            }
                        }
                        for it in sec.items: VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 7px;
                                    horizontal-stretch: 0;
                                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.ink(sec.kind); }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    if it.title != "": Text { text: it.title; font-size: 15px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                                    Text { text: it.text; font-size: 13.5px; color: Theme.fg-muted; wrap: word-wrap; }
                                }
                            }
                            if it.media.has: HorizontalLayout {
                                padding-left: 16px;
                                MediaView { m: it.media; }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingsPanel inherits Rectangle {
    in property <DiscordPage> d;
    in property <[string]> previews;
    in property <string> rpc-status;
    in property <int> rpc-state;
    in property <string> widget-status;
    in property <int> widget-state;
    in property <string> layout-status;
    in property <bool> layout-error;
    in property <bool> layout-busy;
    in property <string> patch-status;
    in property <int> patch-state;
    in property <string> qllog-status;
    in property <int> qllog-state;
    in property <UpdatesPage> u;
    in property <string> update-status;
    in property <int> update-state;
    in-out property <int> tab;
    callback close();
    callback whats-new();
    // opening: fade in and rise (a Timer tween; Slint's `animate` jumps to the end in the real window)
    property <float> k: 0;
    Timer { interval: 16ms; running: root.k < 1; triggered => { root.k = min(1, root.k + 16 / 240); } }
    property <float> ek: 1 - Math.pow(1 - root.k, 3);
    opacity: root.ek;
    background: #000000a6;
    TouchArea { clicked => { root.close(); } }
    panel := Rectangle {
        width: min(780px, root.width - 48px);
        height: min(root.height - 64px, body.preferred-height + 2px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - root.ek) * 22px;
        background: Theme.canvas;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line-2;
        clip: true;
        TouchArea { } // clicks inside stay inside
        inner := ScrollView {
            content-width: self.visible-width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: inner.visible-width;
                padding: 24px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "Settings"; font-size: 22px; font-weight: 600; letter-spacing: -0.4px; color: Theme.fg; }
                    }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { root.close(); } }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    // tab numbers stay as they were (0 general, 1 Discord, 2 updates); Discord is shown last, as Experimental
                    Pills {
                        options: ["General", "Updates", "Experimental"];
                        selected: root.tab == 0 ? 0 : root.tab == 2 ? 1 : 2;
                        chosen(i) => { root.tab = i == 0 ? 0 : i == 1 ? 2 : 1; }
                    }
                }

                // ---------------------------------------- general: whose numbers, the game logs
                if root.tab == 0: Rectangle {
                    // switching here: fade in and slide up (Timer tween)
                    property <float> k: 0;
                    property <float> ek: 1 - Math.pow(1 - self.k, 3);
                    opacity: self.ek;
                    Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 260); } }
                    // the wrapper takes its content's height, so the page still lays out and scrolls
                    min-height: tabbody1.min-height;
                    preferred-height: tabbody1.preferred-height;
                    tabbody1 := VerticalLayout {
                        y: (1 - parent.ek) * 8px;
                    spacing: 16px;
                    Eyebrow { text: "YOUR PLAYERS"; }
                    Text {
                        text: "The share card shows these players' numbers (and Discord does, if you turn it on under Experimental). Track yourself on the Ladders tab, then pick yourself here.";
                        font-size: 13px;
                        color: Theme.fg-muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            Mono { text: "R5Reloaded"; }
                            Select { options: root.d.players-r5; selected: root.d.player-r5; chosen(i) => { Actions.player("r5", i); } }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            Mono { text: "Quake Live"; }
                            Select { options: root.d.players-ql; selected: root.d.player-ql; chosen(i) => { Actions.player("ql", i); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line-1; }
                    Eyebrow { text: "R5RELOADED OPPONENTS"; }
                    SettingRow {
                        on: root.d.r5-patch;
                        title: "Log who I fight in R5Reloaded";
                        body: "Adds a few lines to R5Reloaded's own script (cl_obituary.gnut) so the game writes each of your kills and deaths, with the other player's name, to its log. x76tracker reads that log to show who you fought, their Elo, upsets and your best wins. The original file is kept as a backup, and switching this off takes the lines out again. If a game update replaces the file, x76tracker puts the patch back.";
                        toggled(v) => { Actions.r5-patch(v); }
                    }
                    StatusLine { text: root.patch-status; state: root.patch-state; }
                    if !root.d.r5-found: VerticalLayout {
                        spacing: 6px;
                        Mono { text: "R5Reloaded folder"; }
                        Field { mono: true; placeholder: "the folder with r5apex.exe, e.g. C:\\R5R Library\\LIVE"; edited(t) => { Actions.r5-path(t); } }
                    }
                    Rectangle { height: 1px; background: Theme.line-1; }
                    Eyebrow { text: "QUAKE LIVE OPPONENTS"; }
                    SettingRow {
                        on: root.d.ql-log;
                        title: "Log who I fight in Quake Live";
                        body: "Adds set logfile 2 to Quake Live's autoexec.cfg, so the game saves its console to qconsole.log. x76tracker reads your kills and deaths there, with both players' accuracy from x76's arena, to show who you fought, their Elo and upsets. Switching this off takes the line out.";
                        toggled(v) => { Actions.ql-log(v); }
                    }
                    StatusLine { text: root.qllog-status; state: root.qllog-state; }
                    Rectangle { height: 1px; background: Theme.line-1; }
                    Eyebrow { text: "SESSION RECAP"; }
                    SettingRow {
                        on: root.d.recap-auto;
                        title: "Show a recap when I close a game";
                        body: "When R5Reloaded or Quake Live closes, x76tracker opens a summary of the session: wins and losses, Elo, points and rank, your best win, nemesis and accuracy. Your card's last session link opens it again.";
                        toggled(v) => { Actions.recap-auto(v); }
                    }
                    Rectangle { height: 1px; background: Theme.line-1; }
                    Eyebrow { text: "NOTIFICATIONS"; }
                    SettingRow {
                        on: root.d.notify;
                        title: "Show notifications over my games";
                        body: "A small card slides in at the bottom right for your tier changing, rank milestones, passing or being passed by players you track, and session recaps. It shows over the game without taking focus. Your players are the ones picked above.";
                        toggled(v) => { Actions.notify(v); }
                    }
                    HorizontalLayout { alignment: start; Button { text: "Preview"; kind: 1; clicked => { Actions.notify-test(); } } }
                }
                }

                // ---------------------------------------- experimental: Discord (Rich Presence, and the profile widget for apps that already have one)
                if root.tab == 1: Rectangle {
                    // switching here: fade in and slide up (Timer tween)
                    property <float> k: 0;
                    property <float> ek: 1 - Math.pow(1 - self.k, 3);
                    opacity: self.ek;
                    Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 260); } }
                    // the wrapper takes its content's height, so the page still lays out and scrolls
                    min-height: tabbody2.min-height;
                    preferred-height: tabbody2.preferred-height;
                    tabbody2 := VerticalLayout {
                        y: (1 - parent.ek) * 8px;
                    spacing: 16px;
                    Text {
                        text: "Discord features that are still experimental. Both stay off until you turn them on.";
                        font-size: 14px;
                        color: Theme.fg-muted;
                        wrap: word-wrap;
                    }
                    Eyebrow { text: "RICH PRESENCE"; }
                    SettingRow {
                        on: root.d.rpc;
                        title: "Show my x76 rank on Discord while I play";
                        body: "While R5Reloaded or Quake Live is running, your Discord status shows your tier, rank, Elo and your last 48 hours. Discord just has to be open on this PC.";
                        toggled(v) => { Actions.rpc(v); }
                    }
                    StatusLine { text: root.rpc-status; state: root.rpc-state; }
                    Mono { text: root.d.rpc-app; font-size: 11px; color: Theme.fg-faint; wrap: word-wrap; }
                    Rectangle { height: 1px; background: Theme.line-1; }
                    Eyebrow { text: "DISCORD PROFILE WIDGET"; }
                    Text {
                        text: "Already have a Discord app with a profile widget? x76tracker can fill the widget's User Data fields with your x76 stats. Discord stopped giving widgets to new apps, so this only works with an app that got one before the cutoff.";
                        font-size: 14px;
                        color: Theme.fg-muted;
                        wrap: word-wrap;
                    }
                    Eyebrow { text: "YOUR APP"; }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            Mono { text: "Application ID"; }
                            Field { initial: root.d.app-id; mono: true; placeholder: "Developer Portal → General Information"; edited(t) => { Actions.discord-id("app", t); } }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            Mono { text: "Your Discord user ID"; }
                            Field { initial: root.d.user-id; mono: true; placeholder: "read from Discord when it's open"; edited(t) => { Actions.discord-id("user", t); } }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Mono { text: "Bot token"; }
                        if root.d.has-token: HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Saved on this PC, encrypted for your Windows account."; font-size: 13.5px; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                            VerticalLayout { alignment: center; horizontal-stretch: 0; Button { text: "Remove"; kind: 1; clicked => { Actions.discord-token-clear(); } } }
                        }
                        if !root.d.has-token: HorizontalLayout {
                            spacing: 10px;
                            tok := Field { password: true; placeholder: "paste your app's bot token"; horizontal-stretch: 1; accepted(t) => { Actions.discord-token(t); } }
                            VerticalLayout { alignment: center; horizontal-stretch: 0; Button { text: "Save"; clicked => { Actions.discord-token(tok.value); } } }
                        }
                        Text {
                            text: "Developer Portal → your app → Bot → Reset Token. x76tracker only ever sends it to Discord and never shows it again.";
                            font-size: 12px;
                            color: Theme.fg-faint;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Button { text: root.layout-busy ? "Reading…" : "Read widget layout"; enabled: !root.layout-busy; clicked => { Actions.widget-layout(); } }
                        Button { text: "Developer Portal"; kind: 1; clicked => { Actions.open-url("https://discord.com/developers/applications"); } }
                    }
                    if root.layout-status != "": Text { text: root.layout-status; font-size: 13px; color: root.layout-error ? Theme.danger : Theme.fg-muted; wrap: word-wrap; }
                    Rectangle { height: 1px; background: Theme.line-1; }
                    SettingRow {
                        on: root.d.widget;
                        title: "Update my widget with x76 stats";
                        body: "Sends new numbers when they change, at most every 5 minutes (Discord says widgets aren't for live data). Keep x76tracker open while you play.";
                        toggled(v) => { Actions.widget(v); }
                    }
                    StatusLine { text: root.widget-status; state: root.widget-state; }
                    SettingRow {
                        on: root.d.widget-rpc;
                        title: "Run Rich Presence as this app";
                        body: "The widget's “while playing” panel only shows on this app's activity. Off: Rich Presence runs as x76tracker's own app.";
                        toggled(v) => { Actions.widget-rpc(v); }
                    }
                    if root.d.slots.length > 0: VerticalLayout {
                        spacing: 8px;
                        Eyebrow { text: "FIELDS X76TRACKER FILLS"; }
                        for slot[i] in root.d.slots: SlotRow {
                            slot: slot;
                            preview: i < root.previews.length ? root.previews[i] : "";
                            options: slot.kind == 0 ? root.d.tile-options : slot.kind == 2 ? root.d.image-options : slot.kind == 3 ? root.d.card-options : slot.kind == 4 ? root.d.progress-options : root.d.text-options;
                        }
                        HorizontalLayout {
                            alignment: start;
                            padding-top: 4px;
                            Button { text: "Update now"; kind: 1; enabled: root.d.widget; clicked => { Actions.widget-now(); } }
                        }
                    }
                    if root.d.statics.length > 0: VerticalLayout {
                        spacing: 8px;
                        Eyebrow { text: "FIXED IN DISCORD'S WIDGET EDITOR"; }
                        for st in root.d.statics: HorizontalLayout {
                            spacing: 12px;
                            Mono { text: st.surface + " · " + st.name; width: 150px; overflow: elide; }
                            Text { text: st.text; font-size: 13.5px; color: Theme.fg; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
                        }
                        Text {
                            text: "To fill one of these from x76tracker, open the widget editor in the Developer Portal, set the field's Value Type to User Data, publish, then press Read widget layout. Its current text is kept as the custom text.";
                            font-size: 12px;
                            color: Theme.fg-faint;
                            wrap: word-wrap;
                        }
                    }
                }
                }

                // ---------------------------------------- updates and what's new
                if root.tab == 2: Rectangle {
                    // switching here: fade in and slide up (Timer tween)
                    property <float> k: 0;
                    property <float> ek: 1 - Math.pow(1 - self.k, 3);
                    opacity: self.ek;
                    Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 260); } }
                    // the wrapper takes its content's height, so the page still lays out and scrolls
                    min-height: tabbody3.min-height;
                    preferred-height: tabbody3.preferred-height;
                    tabbody3 := VerticalLayout {
                        y: (1 - parent.ek) * 8px;
                    spacing: 16px;
                    Text { text: "x76tracker " + root.u.version; font-size: 18px; font-weight: 600; color: Theme.fg; }
                    StatusLine { text: root.update-status; state: root.update-state; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if root.u.available != "": Button {
                            text: "Install " + root.u.available + " and restart";
                            enabled: root.u.can-install && !root.u.busy;
                            clicked => { Actions.update-install(); }
                        }
                        Button { text: "Check now"; kind: 1; enabled: !root.u.busy; clicked => { Actions.update-check(); } }
                        Button { text: "Releases on GitHub"; kind: 1; clicked => { Actions.open-url(root.u.page); } }
                    }
                    SettingRow {
                        on: root.u.auto-check;
                        title: "Check for updates";
                        body: "When x76tracker starts and every 6 hours, it asks GitHub for the latest release. Nothing about you is sent.";
                        toggled(v) => { Actions.update-setting("check", v); }
                    }
                    SettingRow {
                        on: root.u.auto-install;
                        title: "Install updates automatically";
                        body: "A new version downloads in the background, is checked against the SHA-256 published with its release, and replaces this one when you close x76tracker.";
                        toggled(v) => { Actions.update-setting("auto", v); }
                    }
                    Rectangle { height: 1px; background: Theme.line-1; }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "What's new"; font-size: 15px; font-weight: 600; color: Theme.fg; }
                            Text { text: "Every version's changes, with pictures."; font-size: 13px; color: Theme.fg-muted; }
                        }
                        VerticalLayout { alignment: center; horizontal-stretch: 0; Button { text: "Open changelog"; kind: 1; clicked => { root.whats-new(); } } }
                    }
                }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- window chrome
// Controls for the custom title bar; handled in Rust through winit (native drag, snap, resize).
export global WindowCtl {
    in-out property <bool> maximized;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close();
    callback resize(direction: int); // 0 N, 1 NE, 2 E, 3 SE, 4 S, 5 SW, 6 W, 7 NW
}

component CaptionButton inherits Rectangle {
    in property <string> icon;
    in property <bool> close;
    callback clicked;
    width: 40px;
    height: 32px;
    border-radius: 8px;
    background: cb-ta.has-hover ? (root.close ? Theme.danger : Theme.surface-2) : transparent;
    animate background { duration: 120ms; }
    Path {
        width: 11px;
        height: 11px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.icon;
        stroke: cb-ta.has-hover && root.close ? #ffffff : Theme.fg-muted;
        stroke-width: 1.3px;
    }
    cb-ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ResizeEdge inherits TouchArea {
    in property <int> direction;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            WindowCtl.resize(root.direction);
        }
    }
}

// ---------------------------------------------------------------- window
// ---------------------------------------------------------------- compact mode (its own small window)
export struct MiniRow {
    game: string, name: string, tier: string, tier-key: int, rank: string, elo: string,
    delta: string, delta-dir: int, since: string, last: string, last-dir: int, streak: string, streak-dir: int,
}

component MiniRowView inherits VerticalLayout {
    in property <MiniRow> r;
    spacing: 6px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout { alignment: center; horizontal-stretch: 0; Gem { tier-key: root.r.tier-key; size: 34px; } }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: root.r.name; font-size: 13.5px; font-weight: 600; color: Theme.fg; overflow: elide; min-width: 0px; }
            HorizontalLayout {
                spacing: 6px;
                Mono { text: root.r.tier; font-size: 10.5px; font-weight: 600; color: Theme.tier-color(root.r.tier-key); horizontal-stretch: 0; }
                // the rank and game give way first when space runs short
                Mono { text: root.r.rank + " · " + root.r.game; font-size: 10.5px; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 0;
            HorizontalLayout {
                alignment: end;
                spacing: 3px;
                Text { text: root.r.elo; font-size: 17px; font-weight: 600; letter-spacing: -0.3px; color: Theme.fg; }
                VerticalLayout { alignment: end; padding-bottom: 2px; Mono { text: "elo"; font-size: 10px; } }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 4px;
                if root.r.delta-dir != 0: Delta { text: root.r.delta; dir: root.r.delta-dir; size: 10.5px; mono: true; }
                if root.r.delta-dir == 0: Mono { text: "±0"; font-size: 10.5px; }
                Mono { text: root.r.since; font-size: 10.5px; color: Theme.fg-faint; }
            }
        }
    }
    if root.r.last != "": HorizontalLayout {
        spacing: 8px;
        Mono {
            text: root.r.last;
            font-size: 10.5px;
            color: root.r.last-dir > 0 ? Theme.positive : root.r.last-dir < 0 ? Theme.danger : Theme.fg-muted;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.r.streak != "": Mono {
            text: root.r.streak;
            font-size: 10.5px;
            font-weight: 600;
            color: root.r.streak-dir > 0 ? Theme.positive : Theme.danger;
            horizontal-stretch: 0;
        }
    }
}

// An always-on-top card with your players' numbers: drag it anywhere, double-click for the app.
// Like notifications it never takes focus, so clicking it over a game leaves the game in front.
export component Mini inherits Window {
    title: "x76tracker mini";
    no-frame: true;
    always-on-top: true;
    width: 330px;
    height: body.preferred-height;
    background: Theme.canvas;
    in property <[MiniRow]> rows;
    out property <length> natural-height: body.preferred-height;
    callback drag();
    callback dismiss();
    callback open-app();
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag();
            }
        }
        double-clicked => { root.open-app(); }
    }
    Rectangle { border-width: 1px; border-color: Theme.line-2; border-radius: 8px; }
    body := VerticalLayout {
        padding: 12px;
        padding-top: 8px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            Mono { text: "x76tracker"; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
            RoundButton { icon: "M 2 10 L 10 2 M 5 2 L 10 2 L 10 7"; clicked => { root.open-app(); } }
            RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { root.dismiss(); } }
        }
        for r in root.rows: MiniRowView { r: r; }
        if root.rows.length == 0: Text {
            text: "Track yourself on the Ladders tab, then pick yourself in Settings → General.";
            font-size: 12px;
            color: Theme.fg-muted;
            wrap: word-wrap;
        }
    }
}

// ---------------------------------------------------------------- notification (its own small window)
// Shown in a screen corner over games: it never takes focus (x76tracker sets that up when it creates
// the window) and slides in and out by moving the window itself.
export component Toast inherits Window {
    title: "x76tracker notification";
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 76px;
    background: Theme.canvas;
    in property <string> heading;
    in property <string> body;
    in property <int> tier-key: -1;
    in property <int> dir;
    callback clicked();
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Rectangle {
        border-width: 1px;
        border-color: Theme.line-2;
        border-radius: 8px;
    }
    // the side bar says good news, bad news or neither at a glance
    Rectangle {
        x: 0;
        width: 4px;
        height: parent.height;
        background: root.dir > 0 ? Theme.positive : root.dir < 0 ? Theme.danger : Theme.accent-fg;
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        spacing: 12px;
        if root.tier-key >= 0: VerticalLayout { alignment: center; horizontal-stretch: 0; Gem { tier-key: root.tier-key; size: 38px; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Mono { text: "x76tracker"; font-size: 10px; }
            Text { text: root.heading; font-size: 15px; font-weight: 600; letter-spacing: -0.2px; color: Theme.fg; overflow: elide; }
            Text { text: root.body; font-size: 12.5px; color: Theme.fg-muted; overflow: elide; }
        }
    }
}

export component AppWindow inherits Window {
    in property <GameData> ql;
    in property <GameData> r5;
    in property <string> ql-status;
    in property <bool> ql-status-error;
    in property <string> r5-status;
    in property <bool> r5-status-error;
    in property <[SearchResult]> ql-results;
    in property <[SearchResult]> r5-results;
    in property <string> ql-search-msg;
    in property <string> r5-search-msg;
    in property <string> live-text: "starting…";
    in property <int> live-state; // 0 idle, 1 live, 2 checking, 3 error
    in property <int> interval-idx: 1;
    in property <[string]> intervals: ["every 30s", "every 1 min", "every 2 min", "every 5 min"];
    in property <int> period;
    in property <string> data-file;
    in property <string> version;
    in property <string> banner-text;
    in property <ProfileCard> profile;
    in property <image> avatar;
    in property <image> banner;
    in property <EventDetail> detail;
    in property <RivalPage> rival;
    in property <RecapPage> recap;
    in-out property <int> tab; // 0 ladders, 1 servers
    in property <ServersPage> servers;
    in property <string> servers-status;
    // settings
    in-out property <bool> settings-open;
    in-out property <int> settings-tab;
    in property <DiscordPage> discord;
    in property <[string]> discord-previews;
    in property <string> rpc-status;
    in property <int> rpc-state; // 0 off, 1 on and waiting, 2 showing, 3 problem
    in property <string> widget-status;
    in property <int> widget-state;
    in property <string> layout-status;
    in property <bool> layout-error;
    in property <bool> layout-busy;
    in property <string> patch-status;
    in property <int> patch-state;
    in property <string> qllog-status;
    in property <int> qllog-state;
    in property <UpdatesPage> updates;
    in property <[ChangeEntry]> changelog;
    in-out property <bool> changelog-open;
    in-out property <int> changelog-index;
    // share card: the preview panel, its save state, and card-only rendering for the PNG export
    in property <ShareCard> share;
    in-out property <bool> card-open;
    in property <bool> card-mode;
    in property <string> card-status;
    in property <bool> card-status-error;
    in property <bool> card-busy;
    in property <bool> card-saved;
    in property <string> update-status;
    in property <int> update-state;
    property <string> period-word: period == 0 ? "today" : period == 1 ? "last 24h" : "since tracking";
    property <bool> wide: sv.visible-width >= 1100px;
    // side margins (x76's 1376px container) and the width of each game column when side by side
    property <length> pad: root.wide ? max(48px, (sv.visible-width - 1376px) / 2) : 20px;
    property <length> col-w: (sv.visible-width - 2 * root.pad - 36px) / 2;
    property <length> edge: 5px;

    public function set-dark(d: bool) {
        Palette.color-scheme = d ? ColorScheme.dark : ColorScheme.light;
    }

    title: "x76tracker";
    icon: @image-url("icon.png");
    no-frame: true;
    preferred-width: 1440px;
    preferred-height: 1000px;
    min-width: 760px;
    min-height: 560px;
    background: Theme.canvas;
    default-font-family: "Archivo";

    VerticalLayout {
        // ------------------------------------------------ title bar: drag to move, double-click to maximize
        Rectangle {
            height: 64px;
            background: Theme.canvas;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        WindowCtl.drag();
                    }
                }
                double-clicked => { WindowCtl.toggle-maximize(); }
            }
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Path {
                        width: 22px;
                        height: 22px;
                        viewbox-width: 32;
                        viewbox-height: 32;
                        commands: "M 6 22 L 12 22 L 12 16 L 18 16 L 18 11 L 26 11";
                        stroke: Theme.fg;
                        stroke-width: 2.4px;
                    }
                }
                Text { horizontal-stretch: 0; text: "x76tracker"; font-size: 17px; font-weight: 600; letter-spacing: -0.34px; color: Theme.fg; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Rectangle {
                        background: Theme.surface-2;
                        border-radius: self.height / 2;
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            Mono { text: "unofficial"; font-size: 10.5px; }
                        }
                    }
                }
                Rectangle { width: 8px; horizontal-stretch: 0; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Pills {
                        options: ["Ladders", "Servers"];
                        selected: root.tab;
                        chosen(i) => { root.tab = i; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 0;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: root.live-state == 1 ? Theme.positive : root.live-state == 2 ? Theme.accent-fg : root.live-state == 3 ? Theme.danger : Theme.fg-faint;
                            // breathes while a check is running
                            opacity: root.live-state == 2 ? 0.35 + 0.65 * (1 + Math.sin(animation-tick() / 1ms * 0.4deg)) / 2 : 1;
                        }
                    }
                    // the status text gives way first (ellipsis) when the window gets narrow
                    Mono { text: root.live-text; font-size: 12px; overflow: elide; min-width: 0px; }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    sel := Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: sel-ta.has-hover ? Theme.line-2 : Theme.line-1;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text { text: root.intervals[root.interval-idx]; font-size: 13px; color: Theme.fg; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 9px;
                                    height: 5px;
                                    viewbox-width: 10;
                                    viewbox-height: 6;
                                    commands: "M 1 1 L 5 5 L 9 1";
                                    stroke: Theme.fg;
                                    stroke-width: 1.4px;
                                }
                            }
                        }
                        sel-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { menu.show(); }
                        }
                        menu := PopupWindow {
                            x: 0;
                            y: sel.height + 6px;
                            width: 160px;
                            Rectangle {
                                // drops in: fade and slide (Timer tween)
                                property <float> k: 0;
                                property <float> ek: 1 - Math.pow(1 - self.k, 3);
                                opacity: self.ek;
                                y: (self.ek - 1) * 8px;
                                Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 170); } }
                                background: Theme.canvas;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.line-1;
                                VerticalLayout {
                                    padding: 6px;
                                    for opt[i] in root.intervals: Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: opt-ta.has-hover ? Theme.surface-2 : transparent;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: opt;
                                                font-size: 13px;
                                                font-weight: i == root.interval-idx ? 600 : 400;
                                                color: Theme.fg;
                                                vertical-alignment: center;
                                            }
                                        }
                                        opt-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { Actions.interval(i); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // a new version is out
                if root.updates.available != "": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: up-ta.has-hover ? Theme.accent-fg.darker(0.12) : Theme.accent-fg;
                        // a slow pulse around it, so a new version gets noticed
                        Rectangle {
                            x: -4px;
                            y: -4px;
                            width: parent.width + 8px;
                            height: parent.height + 8px;
                            border-radius: self.height / 2;
                            border-width: 2px;
                            border-color: Theme.accent-fg;
                            opacity: 0.1 + 0.45 * (1 + Math.sin(animation-tick() / 1ms * 0.18deg)) / 2;
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Update " + root.updates.available;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.dark ? #17161a : #ffffff;
                                vertical-alignment: center;
                            }
                        }
                        up-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.changelog-index = 0;
                                root.changelog-open = true;
                                Actions.changelog-opened();
                            }
                        }
                    }
                }
                // compact mode: a small always-on-top card
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    RoundButton {
                        icon: "M 1 2 L 11 2 L 11 10 L 1 10 Z M 6 6 L 10 6 L 10 9 L 6 9 Z";
                        clicked => { Actions.mini(true); }
                    }
                }
                // settings (a green dot while Rich Presence is showing on Discord)
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        RoundButton {
                            icon: "M 1 3.5 L 11 3.5 M 1 8.5 L 11 8.5 M 4 1.5 L 4 5.5 M 8 6.5 L 8 10.5";
                            clicked => {
                                root.settings-open = true;
                                Actions.settings-opened();
                            }
                        }
                        if root.rpc-state == 2: Rectangle {
                            x: parent.width - 8px;
                            y: -1px;
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: Theme.positive;
                            border-width: 2px;
                            border-color: Theme.canvas;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    RoundButton {
                        icon: "M 6 1.5 A 4.5 4.5 0 1 0 6 10.5 A 4.5 4.5 0 1 0 6 1.5 Z M 6 1.5 L 6 10.5";
                        clicked => {
                            root.set-dark(!Theme.dark);
                            Actions.theme(Theme.dark);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Button { text: "Refresh"; clicked => { Actions.refresh(); } }
                }
                // window controls
                Rectangle { width: 1px; horizontal-stretch: 0; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        spacing: 2px;
                        CaptionButton {
                            icon: "M 1 6 L 11 6";
                            clicked => { WindowCtl.minimize(); }
                        }
                        CaptionButton {
                            icon: WindowCtl.maximized
                                ? "M 3.5 1 L 11 1 L 11 8.5 M 1 3.5 L 8.5 3.5 L 8.5 11 L 1 11 Z"
                                : "M 1 1 L 11 1 L 11 11 L 1 11 Z";
                            clicked => { WindowCtl.toggle-maximize(); }
                        }
                        CaptionButton {
                            icon: "M 1.5 1.5 L 10.5 10.5 M 10.5 1.5 L 1.5 10.5";
                            close: true;
                            clicked => { WindowCtl.close(); }
                        }
                    }
                }
            }
            // hairline under the bar once the page scrolls beneath it
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: sv.content-y < 0 ? Theme.line-1 : transparent;
            }
        }

        // ------------------------------------------------ page
        sv := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: page.preferred-height;

            page := VerticalLayout {
                width: sv.visible-width;
                alignment: start;

                // content column, centred with x76's container width
                HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;

                        if root.tab == 0: Rectangle {
                            // switching here: fade in and slide up (Timer tween)
                            property <float> k: 0;
                            property <float> ek: 1 - Math.pow(1 - self.k, 3);
                            opacity: self.ek;
                            Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 260); } }
                            // the wrapper takes its content's height, so the page still lays out and scrolls
                            min-height: tabbody4.min-height;
                            preferred-height: tabbody4.preferred-height;
                            tabbody4 := VerticalLayout {
                                y: (1 - parent.ek) * 14px;
                            alignment: start;
                        // masthead
                        HorizontalLayout {
                            padding-top: 28px;
                            spacing: 40px;
                            VerticalLayout {
                                horizontal-stretch: 0;
                                spacing: 18px;
                                Text {
                                    text: "Your climb, live.";
                                    font-size: root.wide ? 54px : 40px;
                                    font-weight: 500;
                                    letter-spacing: root.wide ? -1.08px : -0.8px;
                                    color: Theme.fg;
                                }
                                HorizontalLayout {
                                    Text {
                                        text: "Every point you win or lose on the x76 ladders, as it lands. Track yourself and your friends in Quake Live and R5Reloaded.";
                                        font-size: 17px;
                                        color: Theme.fg-muted;
                                        wrap: word-wrap;
                                        preferred-width: 560px;
                                        max-width: 560px;
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: start;
                                padding-top: 6px;
                                horizontal-stretch: 0;
                                Pills {
                                    options: ["Today", "Last 24h", "All tracked"];
                                    selected: root.period;
                                    chosen(i) => { Actions.period(i); }
                                }
                            }
                        }

                        // x76 profile: the card when linked, otherwise a small prompt
                        if root.profile.linked: VerticalLayout {
                            padding-top: 28px;
                            ProfileCardView { p: root.profile; avatar: root.avatar; banner: root.banner; }
                        }
                        if !root.profile.linked: VerticalLayout {
                            padding-top: 20px;
                            LinkProfileRow { busy: root.profile.busy; error: root.profile.error; }
                        }

                        if root.banner-text != "": VerticalLayout {
                            padding-top: 24px;
                            Rectangle {
                                background: Theme.danger-soft;
                                border-radius: 8px;
                                HorizontalLayout {
                                    padding: 10px;
                                    padding-left: 16px;
                                    spacing: 10px;
                                    Text { text: root.banner-text; font-size: 14px; color: Theme.danger; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        RoundButton { icon: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"; clicked => { Actions.dismiss-banner(); } }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 36px; }
                        Rectangle { height: 1px; background: Theme.line-1; }
                        Rectangle { height: 36px; }

                        // games: side by side when wide, stacked when narrow
                        if root.wide: HorizontalLayout {
                            spacing: 36px;
                            // fixed equal halves, whatever each column contains
                            VerticalLayout {
                                alignment: start;
                                width: root.col-w;
                                GameColumn { g: root.ql; status: root.ql-status; status-error: root.ql-status-error; results: root.ql-results; search-msg: root.ql-search-msg; period-word: root.period-word; }
                            }
                            VerticalLayout {
                                alignment: start;
                                width: root.col-w;
                                GameColumn { g: root.r5; status: root.r5-status; status-error: root.r5-status-error; results: root.r5-results; search-msg: root.r5-search-msg; period-word: root.period-word; }
                            }
                        }
                        if !root.wide: VerticalLayout {
                            spacing: 48px;
                            GameColumn { g: root.ql; status: root.ql-status; status-error: root.ql-status-error; results: root.ql-results; search-msg: root.ql-search-msg; period-word: root.period-word; }
                            GameColumn { g: root.r5; status: root.r5-status; status-error: root.r5-status-error; results: root.r5-results; search-msg: root.r5-search-msg; period-word: root.period-word; }
                        }

                        }
                        }
                        if root.tab == 1: Rectangle {
                            // switching here: fade in and slide up (Timer tween)
                            property <float> k: 0;
                            property <float> ek: 1 - Math.pow(1 - self.k, 3);
                            opacity: self.ek;
                            Timer { interval: 16ms; running: parent.k < 1; triggered => { parent.k = min(1, parent.k + 16 / 260); } }
                            // the wrapper takes its content's height, so the page still lays out and scrolls
                            min-height: tabbody5.min-height;
                            preferred-height: tabbody5.preferred-height;
                            tabbody5 := VerticalLayout {
                                y: (1 - parent.ek) * 14px;
                            alignment: start;
                            HorizontalLayout {
                                padding-top: 28px;
                                spacing: 40px;
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    spacing: 18px;
                                    Text {
                                        text: "Who's on.";
                                        font-size: root.wide ? 54px : 40px;
                                        font-weight: 500;
                                        letter-spacing: root.wide ? -1.08px : -0.8px;
                                        color: Theme.fg;
                                    }
                                    HorizontalLayout {
                                        Text {
                                            text: "Live player counts on x76's Quake Live and R5Reloaded servers. The app checks every minute while it's open and remembers the last 7 days.";
                                            font-size: 17px;
                                            color: Theme.fg-muted;
                                            wrap: word-wrap;
                                            preferred-width: 560px;
                                            max-width: 560px;
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 10px;
                                    horizontal-stretch: 0;
                                    Mono { text: root.servers-status; font-size: 12px; }
                                }
                            }
                            Rectangle { height: 36px; }
                            Rectangle { height: 1px; background: Theme.line-1; }
                            Rectangle { height: 36px; }
                            if root.wide: HorizontalLayout {
                                spacing: 36px;
                                VerticalLayout { alignment: start; width: root.col-w; ServerColumn { g: root.servers.ql; } }
                                VerticalLayout { alignment: start; width: root.col-w; ServerColumn { g: root.servers.r5; } }
                            }
                            if !root.wide: VerticalLayout {
                                spacing: 48px;
                                ServerColumn { g: root.servers.ql; }
                                ServerColumn { g: root.servers.r5; }
                            }
                        }
                        }
                        HorizontalLayout {
                            padding-top: 48px;
                            Text {
                                text: "Unofficial and community-made, not affiliated with x76.gg. Points are the ladder number shown on x76.gg; Elo is the hidden rating behind it (Quake Live rating, R5Reloaded elo). History is saved in " + root.data-file + ". Version " + root.version + ".";
                                font-size: 13px;
                                color: Theme.fg-faint;
                                wrap: word-wrap;
                                max-width: 780px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            alignment: start;
                            padding-top: 10px;
                            padding-bottom: 56px;
                            Mono { text: "Made with Slint"; font-size: 11px; color: Theme.fg-faint; }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ result detail panel (over the page, under the title bar edges)
    if root.detail.open: EventPanel {
        y: 64px;
        width: root.width;
        height: root.height - 64px;
        d: root.detail;
    }

    // ------------------------------------------------ session recap
    if root.recap.open: RecapPanel {
        y: 64px;
        width: root.width;
        height: root.height - 64px;
        r: root.recap;
    }

    // ------------------------------------------------ head-to-head (also over the result panel it may come from)
    if root.rival.open: RivalPanel {
        y: 64px;
        width: root.width;
        height: root.height - 64px;
        r: root.rival;
    }

    // ------------------------------------------------ share card
    if root.card-open: SharePanel {
        y: 64px;
        width: root.width;
        height: root.height - 64px;
        c: root.share;
        avatar: root.avatar;
        banner: root.banner;
        status: root.card-status;
        status-error: root.card-status-error;
        busy: root.card-busy;
        saved: root.card-saved;
        close => { root.card-open = false; }
    }

    // ------------------------------------------------ what's new
    if root.changelog-open: ChangelogMenu {
        y: 64px;
        width: root.width;
        height: root.height - 64px;
        entries: root.changelog;
        selected <=> root.changelog-index;
        can-install: root.updates.can-install;
        busy: root.updates.busy;
        close => {
            root.changelog-open = false;
            Actions.changelog-closed();
        }
    }

    // ------------------------------------------------ settings (same place as the detail panel)
    if root.settings-open: SettingsPanel {
        y: 64px;
        width: root.width;
        height: root.height - 64px;
        d: root.discord;
        previews: root.discord-previews;
        rpc-status: root.rpc-status;
        rpc-state: root.rpc-state;
        widget-status: root.widget-status;
        widget-state: root.widget-state;
        layout-status: root.layout-status;
        layout-error: root.layout-error;
        layout-busy: root.layout-busy;
        patch-status: root.patch-status;
        patch-state: root.patch-state;
        qllog-status: root.qllog-status;
        qllog-state: root.qllog-state;
        u: root.updates;
        update-status: root.update-status;
        update-state: root.update-state;
        tab <=> root.settings-tab;
        close => { root.settings-open = false; }
        whats-new => {
            root.settings-open = false;
            root.changelog-index = 0;
            root.changelog-open = true;
            Actions.changelog-opened();
        }
    }

    // ------------------------------------------------ resize handles along the edges (off while maximized)
    if !WindowCtl.maximized: ResizeEdge { x: root.edge * 2; y: 0; width: root.width - 4 * root.edge; height: root.edge; direction: 0; mouse-cursor: ns-resize; }
    if !WindowCtl.maximized: ResizeEdge { x: root.width - root.edge; y: root.edge * 2; width: root.edge; height: root.height - 4 * root.edge; direction: 2; mouse-cursor: ew-resize; }
    if !WindowCtl.maximized: ResizeEdge { x: root.edge * 2; y: root.height - root.edge; width: root.width - 4 * root.edge; height: root.edge; direction: 4; mouse-cursor: ns-resize; }
    if !WindowCtl.maximized: ResizeEdge { x: 0; y: root.edge * 2; width: root.edge; height: root.height - 4 * root.edge; direction: 6; mouse-cursor: ew-resize; }
    if !WindowCtl.maximized: ResizeEdge { x: root.width - 2 * root.edge; y: 0; width: 2 * root.edge; height: 2 * root.edge; direction: 1; mouse-cursor: nesw-resize; }
    if !WindowCtl.maximized: ResizeEdge { x: root.width - 2 * root.edge; y: root.height - 2 * root.edge; width: 2 * root.edge; height: 2 * root.edge; direction: 3; mouse-cursor: nwse-resize; }
    if !WindowCtl.maximized: ResizeEdge { x: 0; y: root.height - 2 * root.edge; width: 2 * root.edge; height: 2 * root.edge; direction: 5; mouse-cursor: nesw-resize; }
    if !WindowCtl.maximized: ResizeEdge { x: 0; y: 0; width: 2 * root.edge; height: 2 * root.edge; direction: 7; mouse-cursor: nwse-resize; }

    // ------------------------------------------------ --card: only the card, for the PNG
    if root.card-mode: ShareCardView {
        x: 0;
        y: 0;
        c: root.share;
        avatar: root.avatar;
        banner: root.banner;
        rounded: false;
    }
}
